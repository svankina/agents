#!/usr/bin/env python3
"""agent-shot — screenshot ONE window, chosen by identity, without disturbing the user.

An agent that needs pixels to verify something must capture *the window it is
verifying*, not "whatever is on screen". Two failure modes this exists to kill:

  1. `screenshot full` / `maim` grabs the user's desktop. The agent then reasons
     about the wrong pixels, and the user's private screen lands in a transcript.
  2. `maim -i <window>` on a window that i3 has unmapped (any window on a
     workspace that is not currently visible) SILENTLY returns the pixels of
     whatever *is* visible there. It never errors. agent-shot refuses instead.

It never focuses a window, never moves a container, never switches a workspace.

Usage:
  agent-shot [selectors] [options]
  agent-shot --list                      # what can I capture?

Selectors (combined with AND; at least one required unless --list/--focused):
  --class RE        window class      (regex, case-insensitive)
  --instance RE     window instance
  --title RE        window title
  --match RE        class, instance or title
  --pid N           owning process (or any of its descendants)
  --con-id N        i3 container id — what `agent-gui` prints on stdout
  --window ID       X window id (0x… or decimal)
  --focused         the focused window (explicit, never a fallback)

Options:
  --display :N      X display (default: $DISPLAY, then the agent display)
  --out PATH        output file (default $AGENT_SHOT_DIR/<slug>_<stamp>.png)
  --all             capture every match instead of refusing an ambiguous one
  --wait SECS       wait for the window to appear and become viewable
  --settle MS       pause before capturing so redraws finish (default 300)
  --frame           include the window manager frame/border
  --json            print a JSON record per capture instead of a bare path
  --allow-blank     keep a capture that is a single flat colour
  --list            list candidate windows (respects the selectors) and exit

Prints the PNG path on stdout, diagnostics on stderr.
Exit codes: 0 captured, 2 usage, 3 no match, 4 ambiguous, 5 not capturable
(window is on a hidden workspace), 6 capture failed.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

AGENT_DISPLAY = os.environ.get("AGENT_DISPLAY", ":99")
SHOT_DIR = Path(os.environ.get("AGENT_SHOT_DIR", Path.home() / ".cache" / "agent-shots"))


def run(cmd, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, env=env)


def xenv(display):
    env = dict(os.environ, DISPLAY=display)
    # I3SOCK pins i3-msg to the user's i3 no matter what DISPLAY says; without
    # it, i3-msg reads the socket path off that display's root window.
    env.pop("I3SOCK", None)
    env.pop("WAYLAND_DISPLAY", None)
    return env


class Win:
    __slots__ = ("id", "con_id", "pid", "cls", "instance", "title",
                 "workspace", "ws_visible", "map_state", "w", "h")

    def __init__(self, wid):
        self.id = wid
        self.con_id = self.pid = None
        self.cls = self.instance = self.title = ""
        self.workspace = None
        self.ws_visible = None
        self.map_state = "?"
        self.w = self.h = 0

    @property
    def viewable(self):
        return self.map_state == "IsViewable"

    def label(self):
        where = f" ws {self.workspace}" if self.workspace else ""
        return f'{self.cls or "?"} "{self.title}" (0x{self.id:x}{where})'

    def slug(self):
        base = self.cls or self.instance or self.title or f"win{self.id:x}"
        return re.sub(r"[^A-Za-z0-9._-]+", "-", base).strip("-").lower() or "window"

    def record(self, display, path):
        return {
            "path": str(path), "display": display, "window": f"0x{self.id:x}",
            "con_id": self.con_id, "pid": self.pid, "class": self.cls,
            "instance": self.instance, "title": self.title,
            "workspace": self.workspace, "width": self.w, "height": self.h,
        }


# --- window discovery ------------------------------------------------------

def i3_windows(env):
    """Windows from the i3 tree: gives con_id, workspace and pid for free."""
    p = run(["i3-msg", "-t", "get_tree"], env)
    if p.returncode != 0 or not p.stdout.strip():
        return None
    try:
        tree = json.loads(p.stdout)
        spaces = json.loads(run(["i3-msg", "-t", "get_workspaces"], env).stdout or "[]")
    except json.JSONDecodeError:
        return None
    visible = {w["name"]: w.get("visible", False) for w in spaces}

    out = []

    def walk(node, ws):
        if node.get("type") == "workspace":
            ws = node.get("name")
        if node.get("window"):
            w = Win(node["window"])
            props = node.get("window_properties") or {}
            w.con_id = node.get("id")
            w.pid = node.get("pid")
            w.cls = props.get("class") or ""
            w.instance = props.get("instance") or ""
            w.title = node.get("name") or props.get("title") or ""
            w.workspace = ws
            w.ws_visible = visible.get(ws)
            out.append(w)
        for key in ("nodes", "floating_nodes"):
            for child in node.get(key, ()):
                walk(child, ws)

    walk(tree, None)
    return out


def x_windows(env):
    """No i3 on this display: EWMH client list, else the root's children."""
    ids = re.findall(r"0x[0-9a-f]+",
                     run(["xprop", "-root", "_NET_CLIENT_LIST"], env).stdout)
    if not ids:
        ids = re.findall(r"^\s+(0x[0-9a-f]+)",
                         run(["xwininfo", "-root", "-children"], env).stdout, re.M)
    out = []
    for sid in ids:
        w = Win(int(sid, 16))
        xp = run(["xprop", "-id", sid, "WM_CLASS", "_NET_WM_NAME", "WM_NAME",
                  "_NET_WM_PID"], env).stdout
        m = re.search(r'WM_CLASS\(STRING\) = "([^"]*)", "([^"]*)"', xp)
        if m:
            w.instance, w.cls = m.group(1), m.group(2)
        m = re.search(r'_NET_WM_NAME\(\w+\) = "(.*)"', xp) or \
            re.search(r'^WM_NAME\(\w+\) = "(.*)"', xp, re.M)
        if m:
            w.title = m.group(1)
        m = re.search(r"_NET_WM_PID\(CARDINAL\) = (\d+)", xp)
        if m:
            w.pid = int(m.group(1))
        out.append(w)
    return out


def measure(win, env):
    """Map state and size, straight from X — the only trustworthy visibility."""
    out = run(["xwininfo", "-id", f"0x{win.id:x}"], env).stdout
    m = re.search(r"Map State:\s+(\w+)", out)
    win.map_state = m.group(1) if m else "?"
    m = re.search(r"Width:\s+(\d+)", out)
    if m:
        win.w = int(m.group(1))
    m = re.search(r"Height:\s+(\d+)", out)
    if m:
        win.h = int(m.group(1))
    if win.pid is None:
        # i3 only reports pid for windows that set _NET_WM_PID and only on
        # newer releases; ask X directly so --pid stays usable.
        m = re.search(r"_NET_WM_PID\(CARDINAL\) = (\d+)",
                      run(["xprop", "-id", f"0x{win.id:x}", "_NET_WM_PID"], env).stdout)
        if m:
            win.pid = int(m.group(1))
    return win.map_state != "?"


def descendants(root_pid):
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat", "rb") as fh:
                data = fh.read()
            ppid = int(data[data.rindex(b")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(int(entry))
    seen, stack = {root_pid}, [root_pid]
    while stack:
        for kid in children.get(stack.pop(), ()):
            if kid not in seen:
                seen.add(kid)
                stack.append(kid)
    return seen


def enumerate_windows(display):
    env = xenv(display)
    wins = i3_windows(env)
    if wins is None:
        wins = x_windows(env)
    wins = [w for w in wins if measure(w, env)]
    return wins


def select(wins, args):
    def rx(pattern, *values):
        r = re.compile(pattern, re.I)
        return any(r.search(v or "") for v in values)

    out = wins
    if args.window is not None:
        wid = int(args.window, 0)
        out = [w for w in out if w.id == wid]
    if args.con_id is not None:
        out = [w for w in out if w.con_id == args.con_id]
    if args.pid is not None:
        pids = descendants(args.pid)
        out = [w for w in out if w.pid in pids]
    if args.cls:
        out = [w for w in out if rx(args.cls, w.cls)]
    if args.instance:
        out = [w for w in out if rx(args.instance, w.instance)]
    if args.title:
        out = [w for w in out if rx(args.title, w.title)]
    if args.match:
        out = [w for w in out if rx(args.match, w.cls, w.instance, w.title)]
    return out


def focused_window(display):
    env = xenv(display)
    p = run(["i3-msg", "-t", "get_tree"], env)
    if p.returncode == 0 and p.stdout.strip():
        try:
            tree = json.loads(p.stdout)
        except json.JSONDecodeError:
            tree = None
        if tree:
            stack = [tree]
            while stack:
                node = stack.pop()
                if node.get("focused") and node.get("window"):
                    return node["window"]
                stack.extend(node.get("nodes", ()) + node.get("floating_nodes", ()))
    out = run(["xdotool", "getactivewindow"], env).stdout.strip()
    return int(out) if out.isdigit() else None


# --- capture ---------------------------------------------------------------

def compositor_running(display):
    """With a compositor on THIS display, a mapped window's own pixels survive
    being covered, so the capture is the target and not whatever sits on top."""
    for name in ("picom", "compton", "xcompmgr", "kwin_x11", "mutter"):
        for pid in run(["pgrep", "-x", name]).stdout.split():
            try:
                with open(f"/proc/{pid}/environ", "rb") as fh:
                    environ = fh.read().decode("utf-8", "replace")
            except OSError:
                continue
            if f"DISPLAY={display}\0" in environ + "\0":
                return True
    return False


def stats(path):
    """(mean, stddev) of the capture, used to catch flat/black grabs."""
    p = run(["convert", str(path), "-format", "%[mean] %[standard-deviation]", "info:"])
    try:
        mean, sd = p.stdout.split()[:2]
        return float(mean), float(sd)
    except (ValueError, IndexError):
        return None, None


def capture(win, display, path, frame, settle_ms, allow_blank):
    env = xenv(display)
    path.parent.mkdir(parents=True, exist_ok=True)
    if settle_ms:
        time.sleep(settle_ms / 1000.0)

    cmd = ["import", "-silent"]
    if frame:
        cmd.append("-frame")
    cmd += ["-window", f"0x{win.id:x}", str(path)]
    p = run(cmd, env)
    if p.returncode != 0 or not path.exists():
        # import reads the window's own drawable and fails loudly when X has no
        # pixels for it. maim reads the screen at the window's rectangle, so it
        # is only ever correct for a window that is genuinely viewable.
        if not win.viewable:
            return False, (p.stderr.strip() or "window has no pixels")
        p = run(["maim", "--quiet", "--hidecursor", "-i", str(win.id), str(path)], env)
        if p.returncode != 0 or not path.exists():
            return False, (p.stderr.strip() or "capture failed")

    mean, sd = stats(path)
    if sd == 0 and not allow_blank:
        path.unlink(missing_ok=True)
        return False, ("capture is a single flat colour — the window has not "
                       "rendered yet; retry with --wait/--settle or --allow-blank")
    return True, None


# --- main ------------------------------------------------------------------

def displays(args):
    """Where to look: an explicit --display, else $DISPLAY then the agent display."""
    if args.display:
        return [args.display]
    order = []
    for d in (os.environ.get("DISPLAY"), AGENT_DISPLAY):
        if d and d not in order and Path(f"/tmp/.X11-unix/X{d.lstrip(':').split('.')[0]}").exists():
            order.append(d)
    return order or [os.environ.get("DISPLAY", ":0")]


def show(wins, display):
    for w in wins:
        state = "viewable" if w.viewable else f"HIDDEN ({w.map_state})"
        print(f"{display}  0x{w.id:x}  con_id={w.con_id}  pid={w.pid}  "
              f"{w.w}x{w.h}  {state}  {w.cls}/{w.instance}  "
              f'ws={w.workspace}  "{w.title}"', file=sys.stderr)


def main(argv):
    ap = argparse.ArgumentParser(prog="agent-shot", add_help=False)
    ap.add_argument("--class", dest="cls")
    ap.add_argument("--instance")
    ap.add_argument("--title")
    ap.add_argument("--match")
    ap.add_argument("--pid", type=int)
    ap.add_argument("--con-id", type=int)
    ap.add_argument("--window", "--id", dest="window")
    ap.add_argument("--focused", action="store_true")
    ap.add_argument("--display")
    ap.add_argument("--out")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--wait", type=float, default=0.0)
    ap.add_argument("--settle", type=int, default=300)
    ap.add_argument("--frame", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--allow-blank", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args(argv)

    if args.help:
        print(__doc__.strip())
        return 0

    if not shutil.which("import") and not shutil.which("maim"):
        print("agent-shot: needs imagemagick (import) or maim", file=sys.stderr)
        return 2

    selectors = (args.cls, args.instance, args.title, args.match, args.pid,
                 args.con_id, args.window)
    if not any(s is not None for s in selectors) and not args.focused and not args.list:
        print("agent-shot: no selector — say which window "
              "(--class/--title/--pid/--con-id/--window/--focused, or --list)",
              file=sys.stderr)
        return 2

    deadline = time.monotonic() + max(args.wait, 0.0)
    matches, display = [], None
    while True:
        for disp in displays(args):
            wins = enumerate_windows(disp)
            if args.focused:
                wid = focused_window(disp)
                wins = [w for w in wins if w.id == wid]
            found = select(wins, args)
            if args.list:
                show(found, disp)
                continue
            if found:
                matches, display = found, disp
                break
        if args.list:
            return 0
        if matches and (args.all or any(w.viewable for w in matches)):
            break
        if time.monotonic() >= deadline:
            break
        time.sleep(0.4)

    if not matches:
        print("agent-shot: no window matched; try --list", file=sys.stderr)
        return 3

    viewable = [w for w in matches if w.viewable]
    if not viewable:
        w = matches[0]
        where = f"i3 workspace {w.workspace}" if w.workspace else "an unmapped state"
        print(f"agent-shot: {w.label()} is not capturable — it is on {where}, "
              f"which is not visible, so X holds no pixels for it "
              f"(map state {w.map_state}).\n"
              f"  agent-shot will not switch the user's workspace to get them.\n"
              f"  Run the app on the agent display instead "
              f"(`agent-gui --headless -- <cmd>`, then agent-shot finds it there), "
              f"or ask the user to make that workspace visible.", file=sys.stderr)
        return 5

    if len(viewable) > 1 and not args.all:
        print(f"agent-shot: {len(viewable)} windows match; narrow the selector "
              f"or pass --all:", file=sys.stderr)
        show(viewable, display)
        return 4

    if not compositor_running(display):
        print("agent-shot: no compositor detected; a window overlapping the "
              "target may bleed into the capture", file=sys.stderr)

    stamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    failures = 0
    for i, w in enumerate(viewable):
        if args.out:
            path = Path(args.out)
            if len(viewable) > 1:
                path = path.with_name(f"{path.stem}_{i}{path.suffix or '.png'}")
        else:
            path = SHOT_DIR / f"{w.slug()}_{stamp}{'' if i == 0 else f'_{i}'}.png"
        ok, err = capture(w, display, path, args.frame, args.settle, args.allow_blank)
        if not ok:
            print(f"agent-shot: {w.label()}: {err}", file=sys.stderr)
            failures += 1
            continue
        print(f"agent-shot: captured {w.label()} on {display}", file=sys.stderr)
        print(json.dumps(w.record(display, path)) if args.json else path)

    return 6 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
