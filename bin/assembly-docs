#!/usr/bin/env python3
"""Build an assembly manual webpage (Voron-style step drawings) and an
interactive assembly animation from one assembly spec, and certify that every
assembly motion is collision-free.

usage:
  assembly-docs check   ASSEMBLY.json                     clearance check (build123d)
  assembly-docs build   ASSEMBLY.json [--draft]           write OUT/site
  assembly-docs publish ASSEMBLY.json [--draft] [--name NAME]  build, serve, print URL

The spec is the single source for the manual, the animation, and the check.
Relative paths resolve against the spec's directory. Lengths are mm, CAD Z up.

  {
    "title": "Spool holder",
    "model": "out/assembly.glb",   build123d export_gltf(..., unit=Unit.M)
    "step": "out/assembly.step",   same compound, used by `check`
    "out": "out/assembly-docs",    default; site in OUT/site, certificate OUT/clearance.json
    "view": {"az": 35, "el": 28},  default camera: az 0 = front (from -Y), 90 = right
    "colors": {"primary": "#3a3d42", "accent": "#d42a30"},
    "parts": {                     keyed by part type (instance name minus _N suffix)
      "base": {"name": "Base", "kind": "printed", "color": "accent"},
      "m3x8_shcs": {"name": "M3x8 SHCS", "kind": "hardware",
                    "description": "ISO 4762 socket head cap screw"}
    },
    "sections": [{"title": "Frame", "steps": [
      {"title": "Lay out the base", "place": ["base"]},
      {"title": "Fit the screws", "view": {"az": 20, "el": 40}, "focus": ["base", "m3x8_*"],
       "moves": [{"parts": ["m3x8_shcs_*"], "from": [0, 0, 30]},
                 {"parts": ["lid"], "path": [[0, 60, 40], [0, 0, 40]]}],
       "notes": [{"title": "Seat fully", "text": "...", "kind": "tip"}]}
    ]}],
    "clearance": {"tolerance_mm": 0.05, "max_mm3": 0.001,
                  "allowed": [{"a": "insert_*", "b": "base", "reason": "heat-set interference"}]},
    "animation": {"speed_mm_s": 60}
  }

Instances are the labelled solids of the exported compound; every instance is
introduced exactly once, by "place" (appears installed) or by a move. A move's
parts travel together along "path" (offsets from the installed pose, visited
in order, ending at the installed pose); "from" is a one-point path. Moves in
a step play in order. Patterns use shell globs over instance names. Part kinds:
printed (color primary|accent|#hex), hardware, purchased, electrical.

Wiring. Electrical parts list their "pins"; off-model ends (controller, supply)
go in "external". Each wire is connected by exactly one step ("wires": [ids or
globs]) after both of its parts are installed, and every electrical instance
needs at least one wire. "route" (assembled CAD mm) draws the wire in the
figures and the animation; "diagram" adds a pin-level draw-wiring picture.

    "parts": {"endstop": {"kind": "electrical", "pins": ["COM", "NO", "NC"]}},
    "external": {"mcu": {"name": "Controller", "pins": ["GND", "IN"]}},
    "wires": {"W1": {"from": "endstop_1.COM", "to": "mcu.GND", "color": "black",
                     "gauge": "24 AWG", "length_mm": 300, "ends": ["solder", "JST-XH"],
                     "route": [[-7, -22, 10], [-7, -30, 10], [-75, -30, -4]], "note": "..."}},
    step: {"title": "Wire the endstop", "wires": ["W*"], "diagram": "wiring/endstop.yaml"}

Wire colors: black red white yellow green blue brown orange violet grey pink
green/yellow, or #rrggbb. Wires are not clearance-checked.

check certifies every move against all parts installed before it: it samples
the exact BREP distance and advances by at least the current clearance, so no
pose between samples penetrates deeper than tolerance_mm. It also checks the
assembled state pairwise. Only translations exist, so the sweep check is
complete. Exit 0 pass, 1 failure, 2 spec or load error. build refuses a stale
or missing certificate unless --draft, which marks the output DRAFT.
"""

import base64
import fnmatch
import hashlib
import html
import json
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ASSETS = Path(__file__).resolve().parent.parent / "shared/skills/documenting-assemblies/assets"
KINDS = ("printed", "hardware", "purchased", "electrical")
NOTE_KINDS = ("note", "tip", "warning")
DEFAULT_COLORS = {"primary": "#3a3d42", "accent": "#d42a30", "hardware": "#a9aeb5", "purchased": "#55595f",
                  "electrical": "#2f6f8f"}
WIRE_COLORS = {"black": "#1c1c1c", "red": "#d22b2b", "white": "#f4f4f4", "yellow": "#e8c51c",
               "green": "#2e9a46", "blue": "#2f62c9", "brown": "#7a4a22", "orange": "#ef7d1a",
               "violet": "#8048c0", "purple": "#8048c0", "grey": "#8c8c8c", "gray": "#8c8c8c",
               "pink": "#f08cb4", "green/yellow": "#6fae2c"}
DEFAULT_VIEW = {"az": 35.0, "el": 28.0}
AUTO_NODE = re.compile(r"^(=>\[?[\d:]*\]?|mesh_\d+(_\d+)?)?$")
COUNTER = re.compile(r"(?:[_-]\d+)+$")
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


class SpecError(Exception):
    pass


def die(msg, code=2):
    print(f"assembly-docs: {msg}", file=sys.stderr)
    sys.exit(code)


def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


# --- spec normalisation (stdlib only) -----------------------------------------

def glb_instances(path):
    """(name, node index) for every glTF node with a mesh, in node order."""
    data = Path(path).read_bytes()
    if data[:4] != b"glTF":
        raise SpecError(f"{path}: not a binary glTF (.glb)")
    length, kind = struct.unpack("<II", data[12:20])
    if kind != 0x4E4F534A:
        raise SpecError(f"{path}: first GLB chunk is not JSON")
    doc = json.loads(data[20:20 + length])
    meshes = doc.get("meshes", [])
    out = []
    for index, node in enumerate(doc.get("nodes", [])):
        if node.get("mesh") is None:
            continue
        name = node.get("name") or ""
        if AUTO_NODE.match(name):
            name = meshes[node["mesh"]].get("name") or ""
        out.append((name, index))
    return out


def check_names(names, where):
    bad = sorted({n for n in names if not n or n.upper() == "SOLID"})
    if bad:
        raise SpecError(f"{where}: unlabelled solids; set solid.label on every exported "
                        f"build123d Solid (labels on a Part or Compound are lost)")
    seen = {}
    for n in names:
        seen[n] = seen.get(n, 0) + 1
    dup = sorted(n for n, c in seen.items() if c > 1)
    if dup:
        raise SpecError(f"{where}: duplicate instance labels {dup}; give every instance a "
                        f"unique label and build repeated parts with copy.deepcopy(), because "
                        f"shared geometry keeps only one label")


def type_of(name):
    return COUNTER.sub("", name) or name


def vec3(value, where):
    if (not isinstance(value, list) or len(value) != 3
            or not all(isinstance(x, (int, float)) and math.isfinite(x) for x in value)):
        raise SpecError(f"{where}: expected [x, y, z] in mm, got {value!r}")
    return [float(x) for x in value]


def view_of(value, inherited, where):
    if value is None:
        return dict(inherited)
    if not isinstance(value, dict) or not set(value) <= {"az", "el"}:
        raise SpecError(f"{where}: view must be {{\"az\": deg, \"el\": deg}}")
    out = dict(inherited)
    for k, v in value.items():
        if not isinstance(v, (int, float)) or not math.isfinite(v):
            raise SpecError(f"{where}: view.{k} must be a number")
        out[k] = float(v)
    return out


def expand(patterns, names, where):
    if isinstance(patterns, str) or not isinstance(patterns, list) or not patterns:
        raise SpecError(f"{where}: expected a non-empty list of instance names or globs")
    out = []
    for pat in patterns:
        hits = [n for n in names if fnmatch.fnmatchcase(n, pat)]
        if not hits:
            raise SpecError(f"{where}: {pat!r} matches no instance")
        out.extend(h for h in hits if h not in out)
    return out


def color_of(meta, kind, colors, where):
    value = meta.get("color", "primary" if kind == "printed" else kind)
    if value in colors:
        return colors[value]
    if isinstance(value, str) and HEX.match(value):
        return value
    raise SpecError(f"{where}: color must be primary, accent, hardware, purchased or #rrggbb")


def load_wires(spec, names, type_info):
    """Wires keyed by id. Endpoints are "<instance>.<pin>" or "<external>.<pin>";
    "route" is an optional polyline in assembled CAD mm for the 3D figures."""
    external = spec.get("external") or {}
    for key, ext in external.items():
        if key in names or not isinstance(ext, dict) or "name" not in ext:
            raise SpecError(f"external.{key}: needs a name and must not reuse an instance name")
    raw_wires = spec.get("wires") or {}
    if not isinstance(raw_wires, dict):
        raise SpecError("wires must be an object keyed by wire id")

    def endpoint(ref, where):
        if not isinstance(ref, str) or "." not in ref:
            raise SpecError(f"{where}: expected <part>.<pin>, got {ref!r}")
        owner, pin = ref.rsplit(".", 1)
        if owner in names:
            pins, label = type_info[type_of(owner)]["pins"], type_info[type_of(owner)]["name"]
            instance = owner
        elif owner in external:
            pins, label, instance = external[owner].get("pins"), external[owner]["name"], None
        else:
            raise SpecError(f"{where}: {owner!r} is neither an instance nor an external entry")
        if pins is not None and pin not in pins:
            raise SpecError(f"{where}: {label} has no pin {pin!r}; pins are {pins}")
        if instance and len(type_info[type_of(owner)]["instances"]) > 1:
            label = f"{label} {owner.rsplit('_', 1)[-1]}"
        return {"ref": ref, "instance": instance, "pin": pin, "label": label}

    wires = {}
    for w_id, raw in raw_wires.items():
        where = f"wires.{w_id}"
        extra = set(raw) - {"from", "to", "color", "gauge", "ends", "route", "length_mm", "note"}
        if extra or "from" not in raw or "to" not in raw or "color" not in raw:
            raise SpecError(f"{where}: needs from, to and color; unknown keys {sorted(extra)}")
        color = raw["color"]
        hexcolor = WIRE_COLORS.get(color.lower()) if isinstance(color, str) else None
        if hexcolor is None and not (isinstance(color, str) and HEX.match(color)):
            raise SpecError(f"{where}.color: one of {sorted(WIRE_COLORS)} or #rrggbb")
        ends = raw.get("ends", ["", ""])
        if not isinstance(ends, list) or len(ends) != 2:
            raise SpecError(f"{where}.ends: [from-end termination, to-end termination]")
        route = [vec3(p, f"{where}.route") for p in raw.get("route", [])]
        if len(route) == 1:
            raise SpecError(f"{where}.route: needs at least two points")
        wires[w_id] = {
            "id": w_id, "from": endpoint(raw["from"], f"{where}.from"), "to": endpoint(raw["to"], f"{where}.to"),
            "color": color, "hex": hexcolor or color, "gauge": raw.get("gauge", ""), "ends": ends,
            "length_mm": raw.get("length_mm"), "note": raw.get("note", ""), "route": route,
        }
    return wires


def load_spec(path):
    path = Path(path).resolve()
    try:
        spec = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        raise SpecError(f"{path}: {e}")
    base = path.parent
    for key in ("title", "model", "step", "sections"):
        if key not in spec:
            raise SpecError(f"spec needs {key!r}")
    model, step_file = base / spec["model"], base / spec["step"]
    for f in (model, step_file):
        if not f.is_file():
            raise SpecError(f"missing file {f}")
    found = glb_instances(model)
    names = [n for n, _ in found]
    check_names(names, model.name)
    node_of = dict(found)

    colors = dict(DEFAULT_COLORS)
    for k, v in (spec.get("colors") or {}).items():
        if k not in DEFAULT_COLORS or not isinstance(v, str) or not HEX.match(v):
            raise SpecError(f"colors.{k}: expected one of {sorted(DEFAULT_COLORS)} as #rrggbb")
        colors[k] = v

    types = {}
    for n in names:
        types.setdefault(type_of(n), []).append(n)
    parts_meta = spec.get("parts") or {}
    unknown = sorted(set(parts_meta) - set(types))
    if unknown:
        raise SpecError(f"parts: {unknown} match no instance type; types are {sorted(types)}")
    type_info = {}
    for t, inst in types.items():
        meta = parts_meta.get(t, {})
        kind = meta.get("kind", "printed")
        if kind not in KINDS:
            raise SpecError(f"parts.{t}.kind must be one of {KINDS}")
        pins = meta.get("pins")
        if pins is not None and (not isinstance(pins, list) or not all(isinstance(p, str) for p in pins)):
            raise SpecError(f"parts.{t}.pins must be a list of pin names")
        type_info[t] = {
            "name": meta.get("name", t.replace("_", " ")), "kind": kind,
            "color": color_of(meta, kind, colors, f"parts.{t}"),
            "accent": meta.get("color") == "accent",
            "description": meta.get("description", ""), "count": len(inst), "instances": inst,
            "pins": pins,
        }

    speed = float((spec.get("animation") or {}).get("speed_mm_s", 60))
    if not speed > 0:
        raise SpecError("animation.speed_mm_s must be positive")
    view = view_of(spec.get("view"), DEFAULT_VIEW, "view")
    wires = load_wires(spec, names, type_info)
    introduced, wired = {}, {}
    sections, steps = [], []
    t = 0.0
    if not isinstance(spec["sections"], list) or not spec["sections"]:
        raise SpecError("sections must be a non-empty list")
    for s_i, section in enumerate(spec["sections"]):
        if "title" not in section or not section.get("steps"):
            raise SpecError(f"sections[{s_i}] needs a title and steps")
        if set(section) - {"title", "steps"}:
            raise SpecError(f"sections[{s_i}]: unknown keys {sorted(set(section) - {'title', 'steps'})}")
        sec = {"title": section["title"], "steps": []}
        step_view = view
        for p_i, raw in enumerate(section["steps"]):
            where = f"sections[{s_i}].steps[{p_i}] ({raw.get('title', '?')})"
            if "title" not in raw:
                raise SpecError(f"{where}: needs a title")
            extra = set(raw) - {"title", "place", "moves", "notes", "view", "focus", "wires", "diagram"}
            if extra:
                raise SpecError(f"{where}: unknown keys {sorted(extra)}")
            step_view = view_of(raw.get("view"), step_view, where)
            step = {"title": raw["title"], "section": s_i, "view": step_view, "t0": t,
                    "place": None, "moves": [], "parts": [], "notes": [], "wires": [], "diagram": None}

            def introduce(found_names, label):
                for n in found_names:
                    if n in introduced:
                        raise SpecError(f"{label}: {n} was already introduced in {introduced[n]}")
                    introduced[n] = label
                    step["parts"].append(n)

            if raw.get("place"):
                placed = expand(raw["place"], names, f"{where}.place")
                introduce(placed, where)
                step["place"] = {"parts": placed, "t0": t}
                t += 0.8
            for m_i, move in enumerate(raw.get("moves") or []):
                mw = f"{where}.moves[{m_i}]"
                extra = set(move) - {"parts", "path", "from"}
                if extra or ("path" in move) == ("from" in move):
                    raise SpecError(f"{mw}: needs parts and exactly one of path or from")
                moved = expand(move.get("parts"), names, f"{mw}.parts")
                introduce(moved, where)
                raw_path = move["path"] if "path" in move else [move["from"]]
                if not isinstance(raw_path, list) or not raw_path:
                    raise SpecError(f"{mw}.path: expected a list of [x, y, z]")
                pts = [vec3(p, f"{mw}.path") for p in raw_path]
                if pts[-1] != [0.0, 0.0, 0.0]:
                    pts.append([0.0, 0.0, 0.0])
                if len(pts) < 2:
                    raise SpecError(f"{mw}: path has no travel; use place instead")
                travel = sum(math.dist(a, b) for a, b in zip(pts, pts[1:]))
                duration = min(4.0, max(0.8, travel / speed))
                m = {"parts": moved, "path": pts, "t0": t, "tm": t + 0.4, "t1": t + 0.4 + duration}
                step["moves"].append(m)
                t = m["t1"] + 0.2
            wire_ids = expand(raw["wires"], list(wires), f"{where}.wires") if raw.get("wires") else []
            if wire_ids:
                start = t
                for w_id in wire_ids:
                    if w_id in wired:
                        raise SpecError(f"{where}: wire {w_id} was already connected in {wired[w_id]}")
                    wired[w_id] = where
                    w = wires[w_id]
                    for end in (w["from"], w["to"]):
                        if end["instance"] and end["instance"] not in introduced:
                            raise SpecError(f"{where}: wire {w_id} connects {end['ref']} before "
                                            f"{end['instance']} is installed")
                    length = sum(math.dist(a, b) for a, b in zip(w["route"], w["route"][1:]))
                    w["t0"], w["t1"] = t, t + min(3.0, max(1.0, length / speed))
                    t = w["t0"] + 0.5
                    step["wires"].append(w_id)
                t = max(start, *(wires[w]["t1"] for w in wire_ids)) + 0.2
            if raw.get("diagram"):
                diagram = base / raw["diagram"]
                if not diagram.is_file():
                    raise SpecError(f"{where}.diagram: missing draw-wiring spec {diagram}")
                step["diagram"] = diagram
            if not step["parts"] and not step["wires"]:
                raise SpecError(f"{where}: introduces no parts or wires; use place, moves or wires")
            for n_i, note in enumerate(raw.get("notes") or []):
                if isinstance(note, str):
                    note = {"title": "Note", "text": note}
                kind = note.get("kind", "note")
                if kind not in NOTE_KINDS or "text" not in note:
                    raise SpecError(f"{where}.notes[{n_i}]: needs text; kind is one of {NOTE_KINDS}")
                step["notes"].append({"title": note.get("title", kind.title()), "text": note["text"], "kind": kind})
            step["focus"] = expand(raw["focus"], names, f"{where}.focus") if "focus" in raw else None
            t += 0.6
            step["t1"] = t
            sec["steps"].append(len(steps))
            steps.append(step)
        sections.append(sec)
    missing = [n for n in names if n not in introduced]
    if missing:
        raise SpecError(f"instances never introduced by any step: {missing}")
    unwired = sorted(set(wires) - set(wired))
    if unwired:
        raise SpecError(f"wires never connected by any step: {unwired}")
    connected = {e["instance"] for w in wires.values() for e in (w["from"], w["to"]) if e["instance"]}
    loose = [n for n in names if type_info[type_of(n)]["kind"] == "electrical" and n not in connected]
    if loose:
        raise SpecError(f"electrical parts with no wire: {loose}; add their wires and a wiring step")

    clearance = spec.get("clearance") or {}
    tol = float(clearance.get("tolerance_mm", 0.05))
    max_mm3 = float(clearance.get("max_mm3", 0.001))
    if not tol > 0 or not max_mm3 >= 0:
        raise SpecError("clearance.tolerance_mm must be > 0 and max_mm3 >= 0")
    allowed = []
    for a_i, rule in enumerate(clearance.get("allowed") or []):
        if not rule.get("reason") or "a" not in rule or "b" not in rule:
            raise SpecError(f"clearance.allowed[{a_i}]: needs a, b and a physical reason")
        for side in ("a", "b"):
            if not any(fnmatch.fnmatchcase(n, rule[side]) for n in names):
                raise SpecError(f"clearance.allowed[{a_i}].{side}: {rule[side]!r} matches no instance")
        allowed.append({"a": rule["a"], "b": rule["b"], "reason": rule["reason"]})

    motion = json.dumps({
        "steps": [{"place": s["place"]["parts"] if s["place"] else [],
                   "moves": [[m["parts"], m["path"]] for m in s["moves"]]} for s in steps],
        "tol": tol, "max_mm3": max_mm3, "allowed": allowed}, sort_keys=True)
    return {
        "path": path, "base": base, "spec": spec, "model": model, "step_file": step_file,
        "out": base / spec.get("out", "out/assembly-docs"),
        "names": names, "node_of": node_of, "types": type_info, "colors": colors,
        "sections": sections, "steps": steps, "duration": t, "view": view,
        "tolerance": tol, "max_mm3": max_mm3, "allowed": allowed,
        "motion_sha256": hashlib.sha256(motion.encode()).hexdigest(),
        "wires": wires,
    }


def is_allowed(norm, a, b):
    for rule in norm["allowed"]:
        if ((fnmatch.fnmatchcase(a, rule["a"]) and fnmatch.fnmatchcase(b, rule["b"]))
                or (fnmatch.fnmatchcase(b, rule["a"]) and fnmatch.fnmatchcase(a, rule["b"]))):
            return rule
    return None


# --- clearance check (build123d) ----------------------------------------------

def step_solids(path):
    from build123d import Solid, import_step

    found = []

    def walk(shape, inherited):
        label = shape.label if shape.label and shape.label.upper() != "SOLID" else inherited
        if isinstance(shape, Solid):
            found.append((label or "", shape))
        for child in getattr(shape, "children", ()) or ():
            walk(child, label)

    root = import_step(str(path))
    walk(root, "")
    if not found:
        found = [(s.label or "", s) for s in root.solids()]
    return found


_SOLIDS = {}


def _box_gap(a, b):
    return math.sqrt(sum(max(0.0, a[0][i] - b[1][i], b[0][i] - a[1][i]) ** 2 for i in range(3)))


def _distance(a, b):
    from OCP.BRepExtrema import BRepExtrema_DistShapeShape
    from OCP.Extrema import Extrema_ExtFlag_MIN

    d = BRepExtrema_DistShapeShape(a.wrapped, b.wrapped, Extrema_ExtFlag_MIN)
    if not d.IsDone():
        raise RuntimeError("BRep distance computation failed")
    return 0.0 if d.InnerSolution() else d.Value()


def _overlap(a, b):
    common = a.intersect(b)
    return common.volume if common is not None else 0.0


def _sweep(job):
    """Advance one solid along one straight segment past one installed solid.

    A sample with clearance g permits a step of g with no contact, so steps of
    max(g, tol) bound any unseen penetration by tol. Bounding-box separation is
    a cheaper lower bound on g and is used when it exceeds tol."""
    from build123d import Location

    key, mover, other, a, b, tol, max_mm3 = job
    solid, target = _SOLIDS[mover], _SOLIDS[other]
    box, tbox = _SOLIDS[(mover, "box")], _SOLIDS[(other, "box")]
    length = math.dist(a, b)
    s, samples, closest, failure = 0.0, 0, math.inf, None
    while True:
        f = s / length if length else 1.0
        pos = [a[i] + (b[i] - a[i]) * f for i in range(3)]
        moved_box = ([box[0][i] + pos[i] for i in range(3)], [box[1][i] + pos[i] for i in range(3)])
        gap = _box_gap(moved_box, tbox)
        if gap <= tol:
            placed = solid.moved(Location(tuple(pos)))
            gap = _distance(placed, target)
            samples += 1
            if gap <= 1e-6:
                vol = _overlap(placed, target)
                if vol > max_mm3:
                    failure = (pos, vol)
                    break
        closest = min(closest, gap)
        if s >= length:
            break
        s = min(length, s + max(gap, tol))
    return key, mover, other, samples, closest, failure


def _assembled(job):
    a, b = job
    return a, b, _overlap(_SOLIDS[a], _SOLIDS[b])


def run_check(norm):
    import multiprocessing
    from concurrent.futures import ProcessPoolExecutor

    solids = step_solids(norm["step_file"])
    labels = [n for n, _ in solids]
    check_names(labels, norm["step_file"].name)
    if set(labels) != set(norm["names"]):
        only_step = sorted(set(labels) - set(norm["names"]))
        only_glb = sorted(set(norm["names"]) - set(labels))
        raise SpecError(f"STEP and GLB instances differ: only in STEP {only_step}, only in GLB {only_glb}; "
                        f"export both from the same compound")
    tol, max_mm3 = norm["tolerance"], norm["max_mm3"]
    for n, s in solids:
        bb = s.bounding_box()
        _SOLIDS[n] = s
        _SOLIDS[(n, "box")] = ([bb.min.X, bb.min.Y, bb.min.Z], [bb.max.X, bb.max.Y, bb.max.Z])
    box = lambda n: _SOLIDS[(n, "box")]  # noqa: E731

    sweeps, moves, installed = [], [], []
    for s_i, step in enumerate(norm["steps"]):
        if step["place"]:
            installed.extend(step["place"]["parts"])
        for m_i, move in enumerate(step["moves"]):
            key = len(moves)
            moves.append({"label": f"step {s_i + 1} ({step['title']}) move {m_i + 1}", "parts": move["parts"],
                          "samples": 0, "closest": math.inf, "pair": None})
            for mover in move["parts"]:
                for other in installed:
                    if is_allowed(norm, mover, other):
                        continue
                    for a, b in zip(move["path"], move["path"][1:]):
                        lo = [min(a[i], b[i]) for i in range(3)]
                        hi = [max(a[i], b[i]) for i in range(3)]
                        swept = ([box(mover)[0][i] + lo[i] for i in range(3)],
                                 [box(mover)[1][i] + hi[i] for i in range(3)])
                        if _box_gap(swept, box(other)) > tol:
                            continue
                        # Pieces of at most 10 mm run in parallel; each starts with an exact sample.
                        pieces = max(1, math.ceil(math.dist(a, b) / 10))
                        for k in range(pieces):
                            p0 = [a[i] + (b[i] - a[i]) * k / pieces for i in range(3)]
                            p1 = [a[i] + (b[i] - a[i]) * (k + 1) / pieces for i in range(3)]
                            sweeps.append((key, mover, other, p0, p1, tol, max_mm3))
            installed.extend(move["parts"])
    # Assembled state, every pair: also covers parts placed or moved together.
    pairs = [(a, b) for i, a in enumerate(norm["names"]) for b in norm["names"][i + 1:]
             if _box_gap(box(a), box(b)) == 0]

    workers = max(1, min(8, len(os.sched_getaffinity(0)) // 2))
    failures, allowed = [], {}
    with ProcessPoolExecutor(workers, mp_context=multiprocessing.get_context("fork")) as pool:
        for key, mover, other, samples, closest, failure in pool.map(_sweep, sweeps):
            m = moves[key]
            m["samples"] += samples
            if closest < m["closest"]:
                m["closest"], m["pair"] = closest, (mover, other)
            if failure:
                pos, vol = failure
                failures.append(f"FAIL {m['label']}: {mover} hits {other} at offset "
                                f"[{pos[0]:.2f}, {pos[1]:.2f}, {pos[2]:.2f}] (overlap {vol:.4g} mm3)")
        for a, b, vol in pool.map(_assembled, pairs):
            if vol <= max_mm3:
                continue
            rule = is_allowed(norm, a, b)
            if rule:
                allowed[(a, b)] = (rule["reason"], vol)
            else:
                failures.append(f"FAIL assembled: {a} overlaps {b} ({vol:.4g} mm3)")

    for m in moves:
        shown = ", ".join(m["parts"][:3]) + (f" +{len(m['parts']) - 3}" if len(m["parts"]) > 3 else "")
        if m["pair"]:
            print(f"move  {m['label']} [{shown}]: {m['samples']} exact samples, closest sampled approach "
                  f"{m['closest']:.3f} mm ({m['pair'][0]} / {m['pair'][1]})")
        else:
            print(f"move  {m['label']} [{shown}]: clear of installed parts by bounding boxes")
    for (a, b), (reason, vol) in sorted(allowed.items()):
        print(f"allow {a} / {b}: {vol:.4g} mm3 overlap installed; {reason}")
    for f in failures:
        print(f)
    status = "fail" if failures else "pass"
    norm["out"].mkdir(parents=True, exist_ok=True)
    cert = norm["out"] / "clearance.json"
    cert.write_text(json.dumps({
        "status": status, "motion_sha256": norm["motion_sha256"],
        "model_sha256": sha256(norm["model"]), "step_sha256": sha256(norm["step_file"]),
        "tolerance_mm": tol, "max_mm3": max_mm3, "failures": failures,
        "allowed": [{"a": a, "b": b, "overlap_mm3": v, "reason": r} for (a, b), (r, v) in sorted(allowed.items())],
        "generated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }, indent=1))
    print(f"{'PASS' if not failures else 'FAIL'}: {len(moves)} moves, {len(norm['names'])} instances, "
          f"tolerance {tol} mm; certificate {cert}")
    return 0 if not failures else 1


# --- site build -----------------------------------------------------------------

def clearance_status(norm, draft):
    cert = norm["out"] / "clearance.json"
    problem = None
    if not cert.is_file():
        problem = "no clearance certificate; run `assembly-docs check` first"
    else:
        c = json.loads(cert.read_text())
        if c.get("status") != "pass":
            problem = "the last clearance check failed"
        elif (c.get("motion_sha256") != norm["motion_sha256"] or c.get("model_sha256") != sha256(norm["model"])
              or c.get("step_sha256") != sha256(norm["step_file"])):
            problem = "the model or motion changed since the clearance check; rerun `assembly-docs check`"
    if problem is None:
        return {"status": "verified",
                "text": f"Clearance checked: no part penetrates another by more than "
                        f"{norm['tolerance']:g} mm along any assembly path"}
    if not draft:
        die(problem, 1)
    print(f"assembly-docs: DRAFT: {problem}", file=sys.stderr)
    return {"status": "draft", "text": "DRAFT: assembly paths not clearance-checked"}


def timeline_json(norm, clearance):
    spec = norm["spec"]
    return {
        "title": spec["title"], "model": "assembly.glb", "view": norm["view"], "duration": norm["duration"],
        "style": {k: norm["colors"][k] for k in ("primary", "accent", "hardware", "purchased")},
        "instances": [{"name": n, "node": norm["node_of"][n], "type": type_of(n),
                       "kind": norm["types"][type_of(n)]["kind"], "color": norm["types"][type_of(n)]["color"]}
                      for n in norm["names"]],
        "sections": norm["sections"],
        "steps": [{k: s[k] for k in ("title", "section", "view", "t0", "t1", "place", "moves", "parts", "notes",
                                     "focus", "wires")} for s in norm["steps"]],
        "wires": {w_id: {k: w[k] for k in ("id", "hex", "color", "route", "t0", "t1", "gauge")}
                  | {"from": f'{w["from"]["label"]} {w["from"]["pin"]}', "to": f'{w["to"]["label"]} {w["to"]["pin"]}',
                     "endpoints": [e["instance"] for e in (w["from"], w["to"]) if e["instance"]]}
                  for w_id, w in norm["wires"].items()},
        "clearance": clearance,
    }


def stage_fonts(site):
    fonts = site / "fonts"
    fonts.mkdir()
    faces = []
    for weight, style in ((300, "Light"), (400, "Regular"), (700, "Bold")):
        try:
            found = subprocess.run(["fc-match", "-f", "%{file}", f"Lato:{style.lower()}"],
                                   capture_output=True, text=True, timeout=10).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            found = ""
        if not found or "Lato" not in Path(found).name:
            continue
        shutil.copyfile(found, fonts / Path(found).name)
        faces.append(f"@font-face {{ font-family: Lato; font-weight: {weight}; "
                     f"src: url('./{Path(found).name}'); }}")
        license_file = Path("/usr/share/doc/fonts-lato/copyright")
        if license_file.is_file() and not (fonts / "LICENSE").exists():
            shutil.copyfile(license_file, fonts / "LICENSE")
    (fonts / "fonts.css").write_text("\n".join(faces) + "\n")


PILL = {"font": "400 15px Lato, 'Open Sans', sans-serif", "padX": 16, "height": 30}
FIG_STEP = (1000, 720)
FIG_PART = (150, 120)


def render_diagram(spec, out):
    """Pin-level wiring picture from a draw-wiring spec (skill://drawing-diagrams)."""
    tool = shutil.which("draw-wiring")
    if not tool:
        die("draw-wiring not on PATH; run ~/src/agents/bin/omp-install")
    res = subprocess.run([tool, str(spec), "-o", str(out), "--no-preview"], capture_output=True, text=True)
    if res.returncode != 0 or not out.is_file():
        die(f"draw-wiring failed on {spec}:\n{res.stderr.strip()}")


def render_figures(site, jobs):
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        die("needs Playwright for Python with Chromium: pip install --user playwright && "
            "playwright install chromium-headless-shell")
    mime = {".html": "text/html", ".js": "text/javascript", ".json": "application/json",
            ".glb": "model/gltf-binary", ".css": "text/css", ".ttf": "font/ttf", ".png": "image/png"}

    def serve(route):
        rel = route.request.url.split("assembly-docs.local/", 1)[1].split("?")[0].split("#")[0]
        f = (site / rel).resolve()
        if site.resolve() not in f.parents or not f.is_file():
            return route.fulfill(status=404, body="not found")
        route.fulfill(status=200, body=f.read_bytes(), content_type=mime.get(f.suffix, "application/octet-stream"))

    results = {}
    errors = []
    with sync_playwright() as p:
        browser = p.chromium.launch(args=["--use-angle=swiftshader", "--enable-unsafe-swiftshader",
                                          "--ignore-gpu-blocklist"])
        page = browser.new_page(viewport={"width": 1800, "height": 1400})
        page.on("pageerror", lambda e: errors.append(str(e)))
        page.on("console", lambda m: m.type == "error" and errors.append(m.text))
        page.route("http://assembly-docs.local/**", serve)
        page.goto("http://assembly-docs.local/render.html")
        page.wait_for_function("window.assemblyRender && window.assemblyRender.ready", timeout=60000)
        if not page.evaluate("async () => await window.assemblyRender.ready"):
            die(f"renderer failed: {page.evaluate('window.assemblyRender.error')} {errors}")
        for key, req in jobs:
            res = page.evaluate("req => window.assemblyRender.figure(req)", req)
            png = base64.b64decode(res["png"].split(",", 1)[1])
            (site / "img" / f"{key}.png").write_bytes(png)
            results[key] = res
            for w in res["warnings"]:
                print(f"assembly-docs: warning: {key}: {w}", file=sys.stderr)
        browser.close()
    if errors:
        die("renderer errors: " + "; ".join(errors))
    return results


def build(norm, draft):
    clearance = clearance_status(norm, draft)
    site = norm["out"] / "site"
    if site.exists():
        shutil.rmtree(site)
    (site / "img").mkdir(parents=True)
    web = ASSETS / "web"
    for name in ("animation.html", "render.html", "app.js", "manual.css"):
        shutil.copyfile(web / name, site / name)
    shutil.copyfile(norm["model"], site / "assembly.glb")
    stage_fonts(site)
    tl = timeline_json(norm, clearance)
    (site / "timeline.json").write_text(json.dumps(tl))

    jobs = []
    for i, step in enumerate(norm["steps"]):
        jobs.append((f"step-{i + 1:02d}", {"kind": "step", "index": i, "width": FIG_STEP[0],
                                           "height": FIG_STEP[1], "pill": PILL,
                                           "labels": step_labels(norm, step)}))
    for t, info in norm["types"].items():
        jobs.append((f"part-{t}", {"kind": "part", "name": info["instances"][0],
                                   "width": FIG_PART[0], "height": FIG_PART[1], "fill": 0.8}))
    figures = render_figures(site, jobs)
    for i, step in enumerate(norm["steps"]):
        if step["diagram"]:
            render_diagram(step["diagram"], site / "img" / f"wiring-{i + 1:02d}.svg")
    (site / "render.html").unlink()
    (site / "index.html").write_text(manual_html(norm, figures, clearance))
    return site


# --- manual HTML ----------------------------------------------------------------

def step_labels(norm, step):
    counts = {}
    for n in step["parts"]:
        counts.setdefault(type_of(n), []).append(n)
    out = []
    for t, inst in counts.items():
        name = norm["types"][t]["name"]
        out.append({"text": f"{name} ×{len(inst)}" if len(inst) > 1 else name, "names": inst, "type": t})
    # Wiring: name each wired part so the reader can match the connection table.
    seen = set(step["parts"])
    for w_id in step["wires"]:
        for end in (norm["wires"][w_id]["from"], norm["wires"][w_id]["to"]):
            if end["instance"] and end["instance"] not in seen:
                seen.add(end["instance"])
                out.append({"text": end["label"], "names": [end["instance"]], "type": type_of(end["instance"])})
    return out


def wire_table(norm, wire_ids, step_of=None):
    rows = []
    for w_id in wire_ids:
        w = norm["wires"][w_id]
        ends = [e for e in w["ends"] if e]
        detail = " · ".join(x for x in (w["color"], w["gauge"],
                                         f'{w["length_mm"]:g} mm' if w["length_mm"] else "",
                                         " / ".join(ends)) if x)
        link = (f'<a href="#step-{step_of[w_id] + 1}">step {step_of[w_id] + 1}</a>'
                if step_of is not None else "")
        note = f'<div class="wnote">{esc(w["note"])}</div>' if w["note"] else ""
        rows.append(f'''<li class="wire"><span class="wswatch" style="background:{w["hex"]}"></span>
  <div><div class="wid">{esc(w_id)} {link}</div>
  <div class="wends">{esc(w["from"]["label"])} <b>{esc(w["from"]["pin"])}</b> → {esc(w["to"]["label"])}
  <b>{esc(w["to"]["pin"])}</b></div><div class="wdetail">{esc(detail)}</div>{note}</div></li>''')
    return f'<ul class="wires">{"".join(rows)}</ul>'


def esc(s):
    return html.escape(str(s), quote=True)


def kind_label(info):
    if info["kind"] == "printed":
        return "Printed · accent" if info["accent"] else "Printed · primary"
    return info["kind"].title()


def part_rows(norm, counts, icons=False):
    rows = []
    for t, qty in counts.items():
        info = norm["types"][t]
        icon = f'<img src="img/part-{esc(t)}.png" alt="">' if icons else ""
        swatch = f'<span class="swatch" style="background:{info["color"]}"></span>'
        rows.append(f'<li class="part">{icon}<span class="qty">{qty}×</span>'
                    f'<span class="pname">{swatch}{esc(info["name"])}</span></li>')
    return "\n".join(rows)


def counts_for(norm, step_indices):
    counts = {}
    for i in step_indices:
        for n in norm["steps"][i]["parts"]:
            counts[type_of(n)] = counts.get(type_of(n), 0) + 1
    return counts


def figure_svg(key, size, res=None):
    """Step figure: one SVG for image and leaders, so they scale together, and
    HTML pills over it, so label text stays readable on small screens."""
    w, h = size
    parts = [f'<image href="img/{key}.png" width="{w}" height="{h}"/>']
    pills = []
    for lab in (res or {}).get("labels", []):
        if lab.get("anchor") is None:
            continue
        ax, ay = lab["anchor"]
        cx, cy = lab["x"] + lab["w"] / 2, lab["y"] + lab["h"] / 2
        parts.append(f'<line class="leader" x1="{ax:.1f}" y1="{ay:.1f}" x2="{cx:.1f}" y2="{cy:.1f}"/>'
                     f'<circle class="leader" cx="{ax:.1f}" cy="{ay:.1f}" r="2.6"/>')
        pills.append(f'<span class="pill" style="left:{100 * cx / w:.2f}%;top:{100 * cy / h:.2f}%">'
                     f'{esc(lab["text"])}</span>')
    return (f'<div class="figure"><svg viewBox="0 0 {w} {h}" role="img">{"".join(parts)}</svg>'
            f'{"".join(pills)}</div>')


def manual_html(norm, figures, clearance):
    title = norm["spec"]["title"]
    draft = clearance["status"] != "verified"
    nav, body = [], []
    for sec in norm["sections"]:
        nav.append(f'<div class="nav-section">{esc(sec["title"])}</div>')
        for i in sec["steps"]:
            step = norm["steps"][i]
            key = f"step-{i + 1:02d}"
            nav.append(f'<a href="#step-{i + 1}"><span class="n">{i + 1}</span>{esc(step["title"])}</a>')
            notes = "".join(f'<div class="note {n["kind"]}"><h4>{esc(n["title"])}</h4><p>{esc(n["text"])}</p></div>'
                            for n in step["notes"])
            diagram = (f'<figure class="diagram"><img src="img/wiring-{i + 1:02d}.svg" alt="Wiring diagram">'
                       f'</figure>' if step["diagram"] else "")
            connections = (f'<h3>Connections</h3>{wire_table(norm, step["wires"])}' if step["wires"] else "")
            parts_here = (f'<h3>This step</h3><ul>{part_rows(norm, counts_for(norm, [i]), icons=True)}</ul>'
                          if step["parts"] else "")
            body.append(f'''<section class="step{" wiring-step" if step["wires"] else ""}" id="step-{i + 1}">
  <div class="figure-wrap">{figure_svg(key, FIG_STEP, figures.get(key))}{diagram}</div>
  <aside>
    <div class="kicker">{esc(sec["title"])} · Step {i + 1} of {len(norm["steps"])}</div>
    <h2>{esc(step["title"])}</h2>
    {notes}
    {connections}
    {parts_here}
    <a class="watch" href="animation.html#step={i + 1}">Watch this step →</a>
  </aside>
</section>''')
    nav.append('<div class="nav-section">Reference</div>')

    cards = []
    for kind in KINDS:
        for t, info in norm["types"].items():
            if info["kind"] != kind:
                continue
            desc = f'<div class="desc">{esc(info["description"])}</div>' if info["description"] else ""
            cards.append(f'''<div class="card"><img src="img/part-{esc(t)}.png" alt="">
  <div><div class="cname">{esc(info["name"])}</div>
  <div class="ckind"><span class="swatch" style="background:{info["color"]}"></span>{esc(kind_label(info))}</div>
  {desc}</div><div class="cqty">×{info["count"]}</div></div>''')
    if norm["wires"]:
        step_of = {w: i for i, s in enumerate(norm["steps"]) for w in s["wires"]}
        nav.append('<a href="#wiring">Wiring</a>')
        body.append(f'''<section class="wiring" id="wiring"><h2>Wiring</h2>
  {wire_table(norm, list(norm["wires"]), step_of)}</section>''')
    nav.append('<a href="#parts">Parts</a>')
    body.append(f'''<section class="parts" id="parts"><h2>Parts</h2><div class="cards">{"".join(cards)}</div>
  <p class="clearance{" draft" if draft else ""}">{esc(clearance["text"])}. The check uses nominal CAD
  geometry; it does not prove fit, strength or print accuracy. Wires are not clearance-checked.</p></section>''')

    return f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)} — assembly manual</title>
<link rel="stylesheet" href="fonts/fonts.css"><link rel="stylesheet" href="manual.css"></head>
<body>
<header class="top"><h1>{esc(title)}</h1>
  <span class="status{" draft" if draft else ""}">{esc(clearance["text"])}</span>
  <a class="animation" href="animation.html">Assembly animation →</a></header>
<div class="layout"><nav class="steps">{"".join(nav)}</nav><main>{"".join(body)}</main></div>
<script>
const links = new Map([...document.querySelectorAll('nav.steps a')].map((a) => [a.hash.slice(1), a]));
const observer = new IntersectionObserver((entries) => {{
  for (const e of entries) if (e.isIntersecting) {{
    links.forEach((a) => a.classList.remove('current'));
    links.get(e.target.id)?.classList.add('current');
  }}
}}, {{ rootMargin: '-45% 0px -50% 0px' }});
document.querySelectorAll('main > section').forEach((s) => observer.observe(s));
</script>
</body></html>
'''


# --- commands -------------------------------------------------------------------

def publish(site, name):
    if not shutil.which("serve-report"):
        die("serve-report not on PATH (see skill://serving-reports)")
    res = subprocess.run(["serve-report", str(site), "--name", name, "--copy"], capture_output=True, text=True)
    if res.returncode != 0:
        die(f"serve-report failed: {res.stderr.strip()}")
    url = res.stdout.strip()
    for page_name, marker in (("", "assembly manual"), ("animation.html", "assembly-docs player")):
        try:
            with urllib.request.urlopen(url.rstrip("/") + "/" + page_name, timeout=8) as r:
                body = r.read().decode("utf-8", "replace")
        except OSError as e:
            die(f"published, but {url}{page_name} is not reachable: {e}")
        if marker not in body:
            die(f"published, but {url}{page_name} does not serve the expected page")
    return url


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd not in ("check", "build", "publish"):
        die(f"unknown command {cmd!r}; see --help")
    draft = False
    name = None
    args = []
    it = iter(rest)
    for a in it:
        if a == "--draft" and cmd != "check":
            draft = True
        elif a == "--name" and cmd == "publish":
            name = next(it, None) or die("--name needs a value")
        elif a.startswith("-"):
            die(f"unknown flag {a} for {cmd}")
        else:
            args.append(a)
    if len(args) != 1:
        die(f"{cmd} needs exactly one ASSEMBLY.json")
    if cmd == "check":
        try:
            import build123d  # noqa: F401
        except ImportError:
            if os.environ.get("ASSEMBLY_DOCS_REEXEC") or not shutil.which("cad-workbench"):
                die("check needs build123d or cad-workbench on PATH")
            os.environ["ASSEMBLY_DOCS_REEXEC"] = "1"
            os.execvp("cad-workbench", ["cad-workbench", "python", __file__, *argv])
    try:
        norm = load_spec(args[0])
        if cmd == "check":
            return run_check(norm)
        site = build(norm, draft)
        if cmd == "build":
            print(site)
        else:
            stem = re.sub(r"[^a-z0-9]+", "-", (name or norm["spec"]["title"]).lower()).strip("-") or "assembly"
            print(publish(site, f"{stem}-assembly"))
        return 0
    except SpecError as e:
        die(str(e))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
