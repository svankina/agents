#!/usr/bin/env python3
"""Reaper: live resource leases, lifecycle events and consumption; read-only."""
from __future__ import annotations

import argparse
import importlib
import json
import os
from pathlib import Path
import select
import secrets
import shutil
import signal
import socket
import sys
import termios
import threading
import time
import tty
from urllib.error import URLError
from urllib.request import urlopen

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from lib.resource_monitor import Collector
from lib.reaper_dashboard import PeerLabels, serve

PANE_TAG = "reaper"
AVATAR = ROOT / "assets" / "reaper.svg"


def herd_module(name):
    launcher = shutil.which("herd-shepherd")
    if not launcher:
        raise RuntimeError("herd-shepherd is not installed; use --watch in a terminal")
    checkout = str(Path(launcher).resolve().parent.parent)
    if checkout not in sys.path:
        sys.path.insert(0, checkout)
    return importlib.import_module(f"herd.{name}")


def open_pane(restart=False):
    client_module = herd_module("brokerclient")
    with client_module.Client() as client:
        old = [row for row in client.list_panes() if row.get("meta", {}).get(PANE_TAG) == "watch"]
        live = next((row for row in old if not row.get("dead")), None)
        if live and not restart:
            print(f"Reaper already open in {live['id']}; focus unchanged")
            return
        token = secrets.token_urlsafe(24)
        # Choose a free loopback port. Child bind and the health check fail closed
        # if another process wins the bind race after releasing the reservation.
        with socket.socket() as reservation:
            reservation.bind(("127.0.0.1", 0))
            port = reservation.getsockname()[1]
            url = f"http://127.0.0.1:{port}/{token}/"
            space = client.space_new("reaper")
            try:
                reservation.close()
                pane = client.spawn(
                    [str(Path(__file__).resolve()), "--serve", "--port", str(port)],
                    cwd=str(Path.home()), env={"REAPER_TOKEN": token},
                    space=space, name="Reaper",
                    meta={PANE_TAG: "watch", "dock": "bots", "avatar": str(AVATAR), "webview": url},
                    cols=140, rows=46,
                )
            except Exception:
                client.kill(space=space)
                raise
        try:
            deadline = time.monotonic() + 15
            while True:
                try:
                    with urlopen(url + "api/snapshot", timeout=1) as response:
                        if json.load(response).get("sampledAt"):
                            break
                except (OSError, URLError, ValueError):
                    pass
                if time.monotonic() >= deadline:
                    raise RuntimeError("Reaper dashboard did not become ready; previous pane was preserved")
                time.sleep(0.1)
        except Exception:
            client.kill(space=space)
            raise
        for row in old:
            client.kill(row["id"])
    print(f"Reaper dashboard ready in {pane}; click his dock row to view")




def clean(value):
    return "".join(c if c.isprintable() else " " for c in str(value))


def bytes_text(value):
    if value is None:
        return "--"
    size = float(value)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(size) < 1024 or unit == "TiB":
            return f"{size:.1f}{unit}" if unit != "B" else f"{size:.0f}B"
        size /= 1024


def summarize(rows):
    result = {}
    for key in ("cpuPercent", "memoryBytes", "tasks", "readBytesPerSec", "writeBytesPerSec"):
        values = [r.get(key) for r in rows if r.get(key) is not None]
        result[key] = sum(values) if values else None
    return result


def usage_text(metrics):
    cpu = "--" if metrics.get("cpuPercent") is None else f"{metrics['cpuPercent']:.1f}%"
    tasks = "--" if metrics.get("tasks") is None else str(metrics["tasks"])
    return f"{cpu:>8} {bytes_text(metrics.get('memoryBytes')):>11} {tasks:>6} {bytes_text(metrics.get('readBytesPerSec')):>10}/s {bytes_text(metrics.get('writeBytesPerSec')):>10}/s"


def render(snapshot, names, width=140, height=46, offset=0, paused=False, owner=None):
    leases = [r for r in snapshot["leases"] if owner is None or r["ownerId"] == owner]
    events = [r for r in snapshot["events"] if owner is None or r["ownerId"] == owner]
    totals = summarize(leases) if owner else snapshot["totals"]
    host = snapshot["host"]
    sampled = time.strftime("%H:%M:%S", time.localtime(snapshot["sampledAt"]))
    rows = [(f"REAPER  |  Resource leases  |  {'PAUSED' if paused else 'LIVE'} {sampled}  |  q quit  p pause  j/k history", "cyan")]
    measured = sum(r.get("memoryBytes") is not None for r in leases)
    failed = sum(r["state"] == "cleanup-failed" for r in leases)
    owners = {r["ownerId"] for r in leases}
    rows.append((f"LEASED  {len(leases)}/32 leases  {len(owners)} agents  {failed} cleanup failures  |  measured {measured}/{len(leases)}  |  per-agent quota 8", "red" if failed else "green"))
    rows.append(("Known lease usage   " + usage_text(totals), None))
    host_cpu = "--" if host.get("cpuPercent") is None else f"{host['cpuPercent']:.1f}%"
    load = "--" if host.get("load1") is None else f"{host['load1']:.2f}"
    rows.append((f"HOST  CPU {host_cpu}  RAM {bytes_text(host.get('memoryUsedBytes'))}/{bytes_text(host.get('memoryTotalBytes'))}  SWAP {bytes_text(host.get('swapUsedBytes'))}/{bytes_text(host.get('swapTotalBytes'))}  load1 {load}", None))
    gpus = host.get("gpus", [])
    if not gpus:
        rows.append(("GPU   unavailable (no NVIDIA metrics); not counted as zero", "dim"))
    for gpu in gpus[:2]:
        utilization = "--" if gpu.get("utilizationPercent") is None else f"{gpu['utilizationPercent']:.0f}%"
        rows.append((f"GPU   {clean(gpu.get('name', 'NVIDIA'))}  busy {utilization}  VRAM {bytes_text(gpu.get('memoryUsedBytes'))}/{bytes_text(gpu.get('memoryTotalBytes'))}  {gpu.get('temperatureC', '--')}C  {gpu.get('powerWatts', '--')}W  [whole host]", None))
    rows.append(("Lease CPU: 100%=one logical CPU. Host CPU: 100%=whole machine. -- means unknown/warming up.", "dim"))
    rows.append(("Lease totals exclude unmanaged processes; host metrics include them. GPU is not attributed to leases.", "dim"))
    rows.append(("", None))
    rows.append((f"{'AGENT':<40} {'LEASES':>6} {'CPU':>8} {'RAM':>11} {'TASKS':>6} {'READ':>12} {'WRITE':>12}", "cyan"))
    groups = {}
    for lease in leases:
        groups.setdefault(lease["ownerId"], []).append(lease)
    grouped = [(id, values, summarize(values)) for id, values in groups.items()]
    grouped.sort(key=lambda row: row[2].get("memoryBytes") or 0, reverse=True)
    group_limit = min(5, max(1, (height - 22) // 4))
    for id, values, metrics in grouped[:group_limit]:
        label = clean(names.get(id, id[:18]))[:40]
        rows.append((f"{label:<40} {len(values):>6} " + usage_text(metrics), None))
    if not grouped:
        rows.append(("No agents currently hold leases.", "dim"))
    elif len(grouped) > group_limit:
        rows.append((f"+ {len(grouped)-group_limit} other agents; --json includes all", "dim"))
    rows.append(("", None))
    rows.append((f"{'RESOURCE / OWNER':<47} {'CPU':>8} {'RAM':>11} {'TASKS':>6} {'READ':>12} {'WRITE':>12}  STATE", "cyan"))
    ranked = sorted(leases, key=lambda r: r.get("memoryBytes") or 0, reverse=True)
    lease_limit = min(8, max(1, (height - 22) // 2))
    for lease in ranked[:lease_limit]:
        label = f"{lease['kind']}/{lease['name']} · {names.get(lease['ownerId'], lease['ownerId'][:12])}"
        rows.append((f"{clean(label)[:47]:<47} " + usage_text(lease) + f"  {lease['state']}", "red" if lease["state"] == "cleanup-failed" else None))
    if not leases:
        rows.append(("No live leases. Waiting for an agent to request resources.", "dim"))
    elif len(leases) > lease_limit:
        rows.append((f"+ {len(leases)-lease_limit} other leases; --json includes all", "dim"))
    rows.append(("", None))
    rows.append((f"RECENT REQUESTS & RELEASES  ({len(events)} available; history offset {offset})", "cyan"))
    errors = snapshot.get("errors", [])
    budget = max(1, height - len(rows) - min(2, len(errors)) - 2)
    for event in events[offset:offset + budget]:
        stamp = time.strftime("%H:%M:%S", time.localtime(event["ts"]))
        actor = clean(names.get(event["ownerId"], event["ownerId"][:16]))[:26]
        text = f"{stamp} {event['action'].upper():<17} {actor:<26} {event['kind']}/{event['name']}"
        if event.get("reason"):
            text += f" — {event['reason']}"
        color = "red" if event["action"] in ("failed", "denied") else "green" if event["action"] in ("released", "reclaimed") else None
        rows.append((text, color))
    if not events:
        rows.append(("No recorded events yet. Requests and releases appear here as they happen.", "dim"))
    for error in errors[:2]:
        rows.append((f"NOTICE  {error}", "yellow"))
    rows.append(("Read-only monitor · no approval prompts, process termination, or automatic release actions", "dim"))
    return [(clean(text)[:max(1, width-1)], color) for text, color in rows[:height]]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--pane", action="store_true", help="open/reuse a background Herd dock pane without selecting it")
    mode.add_argument("--restart", action="store_true", help="replace only this monitor's Herd pane")
    mode.add_argument("--watch", action="store_true", help="continuously monitor in this terminal")
    mode.add_argument("--once", action="store_true", help="print one snapshot (default)")
    mode.add_argument("--serve", action="store_true", help="serve the local read-only dashboard")
    parser.add_argument("--port", type=int, default=0, help="dashboard loopback port (default: automatic)")
    parser.add_argument("--json", action="store_true", help="machine-readable snapshot, including all live leases")
    parser.add_argument("--interval", type=float, default=2, help="refresh seconds (minimum 1)")
    parser.add_argument("--owner", help="filter rendered lease/event rows by exact owner id")
    args = parser.parse_args()
    if args.pane or args.restart:
        open_pane(args.restart)
        return 0
    if args.interval < 1:
        parser.error("--interval must be at least one second")
    if not 0 <= args.port <= 65535:
        parser.error("--port must be between 0 and 65535")
    if args.serve:
        serve(ROOT, lambda: herd_module("peers"), port=args.port, interval=args.interval,
              state_dir=os.environ.get("REAPER_STATE_DIR"))
        return 0
    collector = Collector()
    if not args.watch:
        snapshot = collector.sample()
        if args.json:
            print(json.dumps(snapshot))
        else:
            for text, _ in render(snapshot, {}, *shutil.get_terminal_size((140, 46)), owner=args.owner):
                print(text)
        return 0
    labels = PeerLabels(lambda: herd_module("peers"))
    stopping = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stopping.set())
    terminal = sys.stdin.isatty() and sys.stdout.isatty() and not args.json
    previous = termios.tcgetattr(sys.stdin) if terminal else None
    colors = {"cyan": "\033[1;36m", "green": "\033[32m", "red": "\033[1;31m", "yellow": "\033[33m", "dim": "\033[2m"}
    offset = 0
    paused = False
    snapshot = None
    try:
        if terminal:
            tty.setcbreak(sys.stdin)
            print("\033[?1049h\033[?25l", end="", flush=True)
        while not stopping.is_set():
            if not paused or snapshot is None:
                snapshot = collector.sample()
            width, height = shutil.get_terminal_size((140, 46))
            if args.json:
                print(json.dumps(snapshot), flush=True)
            else:
                lines = render(snapshot, labels.names, width, height, offset, paused, args.owner)
                output = "\033[H" if terminal else ""
                for text, color in lines:
                    output += (colors.get(color, "") if terminal else "") + text + ("\033[0m\033[K" if terminal else "") + "\n"
                output = output.rstrip("\n") + "\033[J" if terminal else output
                print(output, end="", flush=True)
            if terminal and select.select([sys.stdin], [], [], args.interval)[0]:
                key = os.read(sys.stdin.fileno(), 32)
                if b"q" in key or b"\x03" in key:
                    break
                if b"p" in key:
                    paused = not paused
                if b"j" in key:
                    offset = min(max(0, len(snapshot["events"])-1), offset + 3)
                if b"k" in key:
                    offset = max(0, offset - 3)
            elif not terminal:
                stopping.wait(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        labels.stop.set()
        if terminal:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, previous)
            print("\033[?25h\033[?1049l", end="", flush=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError) as error:
        print(f"reaper: {error}", file=sys.stderr)
        raise SystemExit(1)
