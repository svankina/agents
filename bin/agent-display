#!/usr/bin/env python3
"""agent-display — an off-screen X display for agent GUI work.

The user's X display has exactly one problem for agents: a window on a
workspace they are not looking at is *unmapped*, so it has no pixels and cannot
be screenshotted, and the only way to get pixels is to hijack their screen.
This gives agents their own Xvfb display with i3 on it: windows there are
always mapped, always capturable with `agent-shot`, and completely invisible to
the user.

Usage:
  agent-display start                 # idempotent; prints the display, e.g. :99
  agent-display status                # is it up, what is on it
  agent-display stop                  # tear it down
  agent-display exec -- <cmd> [args]  # run a command against it (foreground)
  agent-display view                  # start x11vnc and print how to look at it

Environment:
  AGENT_DISPLAY           display to use (default :99)
  AGENT_DISPLAY_GEOMETRY  screen geometry (default 1920x1080x24)

Exit codes: 0 ok, 2 usage, 3 the display could not be started.
"""

import argparse
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

DISPLAY = os.environ.get("AGENT_DISPLAY", ":99")
GEOMETRY = os.environ.get("AGENT_DISPLAY_GEOMETRY", "1920x1080x24")
STATE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "agent-display"

IPC_SOCKET = STATE / "i3-ipc.sock"

# The "(v4)" comment is load-bearing: without it i3 decides this is a v3 config
# and runs it through i3-migrate-config-to-v4. The explicit ipc-socket keeps
# this i3 off the user's socket path.
I3_CONFIG = f"""# i3 config file (v4) — generated by agent-display, deliberately minimal.
# No bar, no exec lines: this must never start the user's session programs.
font pango:monospace 10
default_border pixel 1
focus_follows_mouse no
workspace_auto_back_and_forth no
ipc-socket {IPC_SOCKET}
"""


def env_for(display=DISPLAY):
    env = dict(os.environ, DISPLAY=display)
    env.pop("WAYLAND_DISPLAY", None)
    # I3SOCK points at the user's i3; inheriting it makes i3-msg (and i3
    # itself) talk to their session instead of this display.
    env.pop("I3SOCK", None)
    return env


def display_up(display=DISPLAY):
    return subprocess.run(["xdpyinfo"], env=env_for(display),
                          capture_output=True).returncode == 0


def pids_of(pattern):
    p = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
    return [int(x) for x in p.stdout.split()]


def xvfb_pids(display=DISPLAY):
    return pids_of(rf"Xvfb {re.escape(display)}\b")


def wm_pids(display=DISPLAY):
    return pids_of(rf"i3 -c {re.escape(str(STATE / 'i3.conf'))}")


def tracked(name):
    """Live pids we started for this display, from STATE/<name>.pid."""
    pidfile = STATE / f"{name}.pid"
    try:
        pid = int(pidfile.read_text().strip())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return []
    return [pid]


def spawn(cmd, log_name, display=DISPLAY):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / log_name, "ab") as log:
        proc = subprocess.Popen(cmd, env=env_for(display), stdin=subprocess.DEVNULL,
                                stdout=log, stderr=subprocess.STDOUT,
                                start_new_session=True)
    (STATE / f"{Path(log_name).stem}.pid").write_text(str(proc.pid))
    return proc


def start(quiet=False):
    STATE.mkdir(parents=True, exist_ok=True)
    note = (lambda *a: None) if quiet else (lambda *a: print(*a, file=sys.stderr))

    if not display_up():
        if not shutil.which("Xvfb"):
            print("agent-display: Xvfb is not installed", file=sys.stderr)
            return None
        spawn(["Xvfb", DISPLAY, "-screen", "0", GEOMETRY, "-nolisten", "tcp",
               "+extension", "COMPOSITE", "+extension", "RANDR"], "xvfb.log")
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline and not display_up():
            time.sleep(0.2)
        if not display_up():
            print(f"agent-display: {DISPLAY} did not come up; see "
                  f"{STATE / 'xvfb.log'}", file=sys.stderr)
            return None
        note(f"agent-display: started Xvfb on {DISPLAY} ({GEOMETRY})")

    conf = STATE / "i3.conf"
    if not conf.exists() or conf.read_text() != I3_CONFIG:
        conf.write_text(I3_CONFIG)
    if shutil.which("i3") and not wm_pids():
        spawn(["i3", "-c", str(conf)], "i3.log")
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not wm_pids():
            time.sleep(0.2)
        note(f"agent-display: started i3 on {DISPLAY}")

    # A compositor keeps each window's own pixels alive when something covers
    # it, so agent-shot captures the target and not the thing on top of it.
    # DISPLAY in the child env is what pins it to this display; compton has no
    # --display flag.
    compositor = next((c for c in ("picom", "compton", "xcompmgr")
                       if shutil.which(c)), None)
    if compositor and not tracked("compositor"):
        args = [compositor] if compositor == "xcompmgr" \
            else [compositor, "--backend", "xrender"]
        spawn(args, "compositor.log")
    return DISPLAY


def windows():
    shot = shutil.which("agent-shot") or str(Path(__file__).with_name("agent-shot"))
    return subprocess.run([shot, "--display", DISPLAY, "--list"],
                          capture_output=True, text=True).stderr.rstrip()


def status():
    up = display_up()
    print(f"display:    {DISPLAY} {'up' if up else 'down'} ({GEOMETRY})")
    print(f"Xvfb:       {xvfb_pids() or '-'}")
    print(f"i3:         {wm_pids() or '-'}")
    print(f"logs:       {STATE}")
    if up:
        wins = windows()
        print("windows:")
        print(wins if wins else "  (none)")
    return 0 if up else 3


def stop():
    killed = []
    for pids in (wm_pids(), tracked("compositor"), tracked("x11vnc"), xvfb_pids()):
        for pid in pids:
            try:
                os.kill(pid, signal.SIGTERM)
                killed.append(pid)
            except OSError:
                pass
        time.sleep(0.2)
    for stale in STATE.glob("*.pid"):
        stale.unlink(missing_ok=True)
    print(f"agent-display: stopped {DISPLAY} (pids {killed or 'none'})", file=sys.stderr)
    return 0


def view():
    if start(quiet=True) is None:
        return 3
    if not shutil.which("x11vnc"):
        print("agent-display: x11vnc is not installed", file=sys.stderr)
        return 3
    if not tracked("x11vnc"):
        spawn(["x11vnc", "-display", DISPLAY, "-localhost", "-rfbport", "5999",
               "-forever", "-shared", "-nopw", "-quiet"], "x11vnc.log")
        time.sleep(1)
    print("vnc://127.0.0.1:5999  (e.g. `vncviewer 127.0.0.1:5999`)")
    return 0


def main(argv):
    ap = argparse.ArgumentParser(prog="agent-display", add_help=False)
    ap.add_argument("command", nargs="?", default="start")
    ap.add_argument("rest", nargs=argparse.REMAINDER)
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args(argv)

    if args.help or args.command in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0

    if args.command == "start":
        display = start()
        if display is None:
            return 3
        print(display)
        return 0
    if args.command == "status":
        return status()
    if args.command == "stop":
        return stop()
    if args.command == "view":
        return view()
    if args.command == "exec":
        cmd = args.rest[1:] if args.rest[:1] == ["--"] else args.rest
        if not cmd:
            print("agent-display: exec needs a command after --", file=sys.stderr)
            return 2
        if start(quiet=True) is None:
            return 3
        os.execvpe(cmd[0], cmd, env_for())
    print(f"agent-display: unknown command {args.command!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
