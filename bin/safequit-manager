#!/usr/bin/env python3
"""safequit-manager — the nanny that actually closes a finished agent's pane.

Agents (the omp `/safequit` extension) send one message when they are done:

    safequit-manager done --agent-pid P --agent-start T \
        --shell-pid S --shell-start U [--pane %5 --tmux-socket /path] [--timeout 60]

The manager waits for the agent process to exit, then kills what the agent
leaves behind: the tmux pane when one was named (which takes the shell and the
terminal real estate with it), otherwise the shell by escalating signals.
Every decision is written to the log, so "it never closed" has an answer.

Identity is (pid, /proc start time): a recycled pid is never signalled, and a
pane is only killed while its #{pane_pid} is still the captured shell.

`done` auto-starts the daemon when the socket is dead. `serve` runs it in the
foreground. The daemon exits after 15 idle minutes; the next `done` restarts
it. Socket: $SAFEQUIT_MANAGER_SOCKET, else $XDG_RUNTIME_DIR/safequit-manager.sock,
else /tmp/safequit-manager-<uid>.sock. Log: $SAFEQUIT_MANAGER_LOG, else
~/.local/state/safequit/manager.log.
"""

import argparse
import json
import os
import signal
import select
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

IDLE_EXIT_SECONDS = 15 * 60
DEFAULT_TIMEOUT = 60.0
KILL_GRACE_SECONDS = 2.0


def socket_path() -> Path:
    explicit = os.environ.get("SAFEQUIT_MANAGER_SOCKET")
    if explicit:
        return Path(explicit)
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return Path(runtime) / "safequit-manager.sock"
    return Path(f"/tmp/safequit-manager-{os.getuid()}.sock")


def log_path() -> Path:
    explicit = os.environ.get("SAFEQUIT_MANAGER_LOG")
    if explicit:
        return Path(explicit)
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    return state / "safequit" / "manager.log"


def log(message: str) -> None:
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} [{os.getpid()}] {message}\n"
    try:
        path = log_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as handle:
            handle.write(line)
    except OSError:
        pass
    print(line, end="", file=sys.stderr)


def start_time(pid: int) -> str | None:
    """Field 22 of /proc/<pid>/stat — the kernel's boot-relative start tick."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    return stat[stat.rindex(") ") + 2 :].split()[19]


def alive(pid: int, expected_start: str) -> bool:
    return start_time(pid) == expected_start


def wait_for_exit(pid: int, expected_start: str, timeout: float) -> bool:
    """Block until the process exits; True on exit, False on timeout.

    Uses pidfd_open + select for a real exit event (no polling); a recycled
    pid never matches expected_start, so it counts as already exited. Falls
    back to a 50ms /proc poll only when pidfd is unavailable.
    """
    deadline = time.monotonic() + timeout
    if not alive(pid, expected_start):
        return True
    try:
        fd = os.pidfd_open(pid)
    except OSError:
        fd = None
    if fd is not None:
        try:
            if not alive(pid, expected_start):
                return True  # exited (or pid recycled) while opening
            readable, _, _ = select.select([fd], [], [], max(0.0, deadline - time.monotonic()))
            return bool(readable) or not alive(pid, expected_start)
        finally:
            os.close(fd)
    while alive(pid, expected_start):
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.05)
    return True


def tmux_pane_pid(tmux_socket: str | None, pane: str) -> int | None:
    command = ["tmux"]
    if tmux_socket:
        command += ["-S", tmux_socket]
    command += ["display-message", "-p", "-t", pane, "#{pane_pid}"]
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    try:
        return int(out.stdout.strip())
    except ValueError:
        return None


def kill_pane(tmux_socket: str | None, pane: str) -> bool:
    command = ["tmux"]
    if tmux_socket:
        command += ["-S", tmux_socket]
    command += ["kill-pane", "-t", pane]
    try:
        return subprocess.run(command, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def escalate(pid: int, expected_start: str) -> str:
    for name, sig in (("SIGHUP", signal.SIGHUP), ("SIGTERM", signal.SIGTERM), ("SIGKILL", signal.SIGKILL)):
        if not alive(pid, expected_start):
            return "gone"
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return "gone"
        except PermissionError:
            return "not permitted"
        deadline = time.monotonic() + KILL_GRACE_SECONDS
        while time.monotonic() < deadline:
            if not alive(pid, expected_start):
                return name
            time.sleep(0.05)
    return "survived SIGKILL"


def handle(request: dict) -> None:
    agent_pid = int(request["agent_pid"])
    agent_start = str(request["agent_start"])
    shell_pid = int(request["shell_pid"])
    shell_start = str(request["shell_start"])
    pane = request.get("pane")
    tmux_socket = request.get("tmux_socket")
    timeout = float(request.get("timeout") or DEFAULT_TIMEOUT)

    label = f"agent {agent_pid} shell {shell_pid} pane {pane or '-'}"
    if not wait_for_exit(agent_pid, agent_start, timeout):
        log(f"{label}: agent still running after {timeout:.0f}s; leaving everything alone")
        return

    if pane:
        current = tmux_pane_pid(tmux_socket, pane)
        if current == shell_pid and alive(shell_pid, shell_start):
            if kill_pane(tmux_socket, pane):
                log(f"{label}: killed pane {pane}")
                return
            log(f"{label}: tmux kill-pane failed; falling back to signals")
        else:
            log(f"{label}: pane {pane} no longer holds shell {shell_pid} (holds {current}); falling back to signals")

    if not alive(shell_pid, shell_start):
        log(f"{label}: shell already gone")
        return
    outcome = escalate(shell_pid, shell_start)
    log(f"{label}: shell {shell_pid} -> {outcome}")


def serve() -> int:
    path = socket_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(str(path))
    except OSError:
        # A live daemon owns the socket; a dead one left a stale file.
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(str(path))
            probe.close()
            log("another daemon owns the socket; exiting")
            return 0
        except OSError:
            path.unlink(missing_ok=True)
            server.bind(str(path))
    os.chmod(path, 0o600)
    server.listen()
    server.settimeout(1.0)
    log(f"serving on {path}")
    pending = threading.Semaphore(0)
    active: list[int] = [0]
    lock = threading.Lock()
    last_work = time.monotonic()

    def worker(connection: socket.socket) -> None:
        try:
            with connection:
                data = connection.makefile("r").readline()
                request = json.loads(data)
                connection.sendall(b"ok\n")
                handle(request)
        except Exception as error:  # a bad request must not kill the daemon
            log(f"request failed: {error!r}")
        finally:
            with lock:
                active[0] -= 1

    try:
        while True:
            try:
                connection, _ = server.accept()
            except socket.timeout:
                with lock:
                    busy = active[0]
                if not busy and time.monotonic() - last_work > IDLE_EXIT_SECONDS:
                    log("idle; exiting")
                    return 0
                continue
            last_work = time.monotonic()
            with lock:
                active[0] += 1
            threading.Thread(target=worker, args=(connection,), daemon=False).start()
    finally:
        server.close()
        path.unlink(missing_ok=True)


def send(request: dict) -> bool:
    path = socket_path()
    for attempt in range(3):
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(5.0)
        try:
            client.connect(str(path))
            client.sendall((json.dumps(request) + "\n").encode())
            return client.makefile("r").readline().strip() == "ok"
        except OSError:
            if attempt == 0:
                subprocess.Popen(
                    [sys.executable, os.path.realpath(__file__), "serve"],
                    start_new_session=True,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            time.sleep(0.3 * (attempt + 1))
        finally:
            client.close()
    return False


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="safequit-manager", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("serve", help="run the daemon in the foreground")
    done = commands.add_parser("done", help="report a finished agent; the manager closes its pane")
    done.add_argument("--agent-pid", type=int, required=True)
    done.add_argument("--agent-start", required=True)
    done.add_argument("--shell-pid", type=int, required=True)
    done.add_argument("--shell-start", required=True)
    done.add_argument("--pane")
    done.add_argument("--tmux-socket")
    done.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    arguments = parser.parse_args(argv)

    if arguments.command == "serve":
        return serve()
    request = {
        "agent_pid": arguments.agent_pid,
        "agent_start": arguments.agent_start,
        "shell_pid": arguments.shell_pid,
        "shell_start": arguments.shell_start,
        "pane": arguments.pane,
        "tmux_socket": arguments.tmux_socket,
        "timeout": arguments.timeout,
    }
    if send(request):
        return 0
    print("safequit-manager: could not reach or start the daemon", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
