#!/usr/bin/env bash
# project-map — curated per-project agent context in AGENTS.md.
#
# The embedded Project map section is the distilled, auto-read project brief:
# architecture, where-things-live, invariants, and dated decisions. The WHOLE
# AGENTS.md is hard-capped so it stays curated. Existing NOTES.md files are
# optional archives. Review age comes from git, not from an in-file marker.
#
# Usage:
#   project-map owned [DIR]    exit 0 if DIR is a repo the user owns
#   project-map init [DIR]     add a Project map section to AGENTS.md
#   project-map lint [DIR]     enforce the AGENTS.md contract
#   project-map check [DIR]    check last-touch age vs repo activity
set -euo pipefail

MAX_LINES=150
STALE_COMMITS=30
STALE_DAYS=60
PROJECT_MAP_HEADING="## Project map"
EMPTY_COMMENT="<!-- project-map-empty: Add only facts for which the litmus is yes: would a fresh agent work incorrectly or slowly without this? Remove this comment when the map has content. -->"
SECTIONS=("### Architecture" "### Where things live" "### Invariants & gotchas" "### Decisions")
# Machine-wide rules already in the generated global instructions. Restating
# them per repo is duplication, never repo context.
GLOBAL_FAIL='psudo|serve-report|fair-run|trash-put|agent-worktree|python3 -m http\.server|:8789'
GLOBAL_WARN='build123d|OpenSCAD|Blender|serve-cad|homer-notify|agent-shot|agent-gui'
# Session residue: commit hashes and scratch paths never belong in a brief.
RESIDUE='`[0-9a-f]{7,40}`|commit [0-9a-f]{7,40}|/tmp/'

die() { echo "project-map: $*" >&2; exit 1; }

cmd="${1:-}"; shift || true
dir="${1:-.}"
agents="$dir/AGENTS.md"

extract_section() {
  awk '
    $0 == "## Project map" && !found { found = 1; in_map = 1 }
    in_map && $0 ~ /^## / && $0 != "## Project map" { exit }
    in_map { print }
  ' "$agents"
}

# Owned = no origin, or origin under github svankina/ or the local GitLab
# root/ namespace. Upstream clones (llama.cpp, codex, Hyprland, …) get no map.
is_owned() {
  local url
  url=$(git -C "$dir" remote get-url origin 2>/dev/null) || return 0
  case "$url" in
    *github.com[:/]svankina/*) return 0 ;;
    *localhost:2222/root/*|*gitlab.local[:/]root/*|*gitlab.local:2222/root/*) return 0 ;;
    "") return 0 ;;
    *) return 1 ;;
  esac
}

case "$cmd" in
  owned)
    [ -d "$dir" ] || die "$dir is not a directory"
    if is_owned; then
      echo "OK $dir: owned"
    else
      echo "SKIP $dir: origin is not user-owned ($(git -C "$dir" remote get-url origin)) — no project map for upstream clones" >&2
      exit 3
    fi
    ;;

  init)
    [ -d "$dir" ] || die "$dir is not a directory"
    force=0
    [ "${2:-}" = "--force" ] && force=1
    if [ "$force" -eq 0 ] && ! is_owned; then
      "$0" owned "$dir" || exit $?
    fi
    if [ -f "$agents" ] && grep -qxF "$PROJECT_MAP_HEADING" "$agents"; then
      die "$agents already contains a Project map section"
    fi

    name="$(basename "$(cd "$dir" && pwd)")"
    if [ ! -e "$agents" ]; then
      printf '# %s\n' "$name" > "$agents"
    elif [ ! -f "$agents" ]; then
      die "$agents is not a regular file"
    fi

    if [ -s "$agents" ] && [ "$(tail -c 1 "$agents" | wc -l)" -eq 0 ]; then
      printf '\n' >> "$agents"
    fi
    cat >> "$agents" <<EOF

## Project map
$EMPTY_COMMENT

### Architecture

### Where things live

### Invariants & gotchas

### Decisions
EOF
    echo "$agents"
    ;;

  lint)
    [ -f "$agents" ] || die "$agents missing (run: project-map init $dir)"
    rc=0

    heading_count=$(awk '$0 == "## Project map" { count++ } END { print count + 0 }' "$agents")
    if [ "$heading_count" -ne 1 ]; then
      echo "FAIL $agents: expected exactly one '$PROJECT_MAP_HEADING' heading (found $heading_count)" >&2
      rc=1
    fi

    lines=$(awk 'END { print NR + 0 }' "$agents")
    if [ "$lines" -gt "$MAX_LINES" ]; then
      echo "FAIL $agents: $lines lines (cap $MAX_LINES for the whole file) — remove duplication; keep only operating constraints and the project map here" >&2
      rc=1
    fi

    section_file=$(mktemp)
    trap 'rm -f "$section_file"' EXIT
    extract_section > "$section_file"
    actual_sections=$(awk '/^### / { print }' "$section_file")
    expected_sections=$(printf '%s\n' "${SECTIONS[@]}")
    if [ "$actual_sections" != "$expected_sections" ]; then
      echo "FAIL $agents: Project map must contain exactly the four required ### subsections in contract order" >&2
      rc=1
    fi

    if grep -nq 'project-map-reviewed:' "$agents"; then
      echo "FAIL $agents: drop the project-map-reviewed marker; review age is git log -1 -- AGENTS.md" >&2
      rc=1
    fi

    if hits=$(grep -nE "$RESIDUE" "$agents"); then
      echo "FAIL $agents: commit hashes and /tmp paths are session residue, not project context:" >&2
      echo "$hits" | sed 's/^/  /' >&2
      rc=1
    fi

    # The repo that ships these commands (bin/project-map lives there) may
    # name them; everywhere else they are restated global rules.
    if [ ! -f "$dir/bin/project-map" ] && hits=$(grep -nE "$GLOBAL_FAIL" "$agents"); then
      echo "FAIL $agents: restates machine-wide rules already in the global instructions — delete these lines:" >&2
      echo "$hits" | sed 's/^/  /' >&2
      rc=1
    fi

    if hits=$(grep -nE "$GLOBAL_WARN" "$agents"); then
      echo "WARN $agents: mentions global tools/rules — keep only if the line says something repo-specific:" >&2
      echo "$hits" | sed 's/^/  /' >&2
    fi

    if [ "$rc" -eq 0 ]; then
      echo "OK $agents: $lines/$MAX_LINES lines"
    fi
    exit "$rc"
    ;;

  check)
    lint_rc=0
    "$0" lint "$dir" >/dev/null || lint_rc=$?
    [ "$lint_rc" -eq 0 ] || exit "$lint_rc"
    git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "$dir is not a git repo"

    review_date=$(git -C "$dir" log -1 --format=%cs -- AGENTS.md)
    [ -n "$review_date" ] || die "$agents has never been committed"
    today=$(date +%F)
    review_epoch=$(date -d "$review_date" +%s)
    today_epoch=$(date -d "$today" +%s)
    days=$(( (today_epoch - review_epoch) / 86400 ))
    day_after=$(date -d "$review_date + 1 day" +%F)
    commits=$(git -C "$dir" rev-list --count --since="$day_after 00:00:00" HEAD)

    if [ "$days" -gt "$STALE_DAYS" ] || [ "$commits" -gt "$STALE_COMMITS" ]; then
      echo "STALE $agents: last touched $review_date ($days days / $commits commits since) — review it"
      exit 2
    fi
    echo "OK $agents: last touched $review_date ($days days / $commits commits since)"
    ;;

  *)
    die "usage: project-map {owned|init|lint|check} [DIR]"
    ;;
esac
