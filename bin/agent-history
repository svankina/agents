#!/usr/bin/env python3
"""Read local work summaries for this folder or Git project.

agent-status records each summary here before attempting Mattermost delivery.
Git subdirectories and linked worktrees share history; non-Git folders are exact
scopes. Storage: $XDG_STATE_HOME/agent-history/history.sqlite3 (default ~/.local/state).
Records describe reported work, not proof of delivery or current repository state.
"""

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import sqlite3
import subprocess
import sys


def git(cwd, *args):
    result = subprocess.run(
        ["git", "-C", str(cwd), *args], stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL, check=False,
    )
    return os.fsdecode(result.stdout).rstrip("\n") if result.returncode == 0 else ""


def context(folder):
    cwd = folder.expanduser().resolve(strict=True)
    if not cwd.is_dir():
        raise ValueError(f"not a directory: {cwd}")
    project = str(cwd)
    branch = commit = ""
    if git(cwd, "rev-parse", "--is-inside-work-tree") == "true":
        # NUL-delimited porcelain preserves whitespace and unusual path names.
        first = git(cwd, "worktree", "list", "--porcelain", "-z").split("\0", 1)[0]
        if not first.startswith("worktree "):
            raise ValueError(f"cannot resolve main worktree for {cwd}")
        project = str(Path(first[len("worktree "):]).resolve())
        branch = git(cwd, "symbolic-ref", "--quiet", "--short", "HEAD")
        commit = git(cwd, "rev-parse", "--verify", "HEAD")
    return {"project": project, "cwd": str(cwd), "branch": branch, "commit": commit}


def database():
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state).expanduser().resolve() / "agent-history/history.sqlite3"


def record(db, ctx, source, channel, message):
    # SQLite transactions serialize concurrent agents without partial records.
    db.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with sqlite3.connect(db, timeout=30) as conn:
        conn.execute("""CREATE TABLE IF NOT EXISTS entries (
            id INTEGER PRIMARY KEY, timestamp TEXT NOT NULL,
            project TEXT NOT NULL, cwd TEXT NOT NULL, source TEXT NOT NULL,
            branch TEXT NOT NULL, commit_hash TEXT NOT NULL,
            channel TEXT NOT NULL, message TEXT NOT NULL
        )""")
        conn.execute("CREATE INDEX IF NOT EXISTS entries_project ON entries(project, id)")
        conn.execute(
            "INSERT INTO entries (timestamp, project, cwd, source, branch, commit_hash, channel, message) "
            "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            (datetime.now(timezone.utc).isoformat(timespec="seconds"), ctx["project"],
             ctx["cwd"], source, ctx["branch"], ctx["commit"], channel, message),
        )


def entries(db, project, search, limit):
    if not db.exists():
        return []
    with sqlite3.connect(db.as_uri() + "?mode=ro", uri=True, timeout=30) as conn:
        conn.row_factory = sqlite3.Row
        return [dict(row) for row in conn.execute(
            "SELECT id, timestamp, project, cwd, source, branch, commit_hash AS 'commit', "
            "channel, message FROM entries WHERE project = ? "
            "AND instr(lower(message), lower(?)) > 0 ORDER BY id DESC LIMIT ?",
            (project, search, limit),
        )]


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--cwd", type=Path, default=Path.cwd(), help="folder to inspect or record (default: current)")
    parser.add_argument("--search", default="", help="literal case-insensitive summary search")
    parser.add_argument("--limit", type=positive, default=20, help="maximum newest entries (default: 20)")
    parser.add_argument("--json", action="store_true", help="emit full records as a JSON array")
    commands = parser.add_subparsers(dest="command")
    add = commands.add_parser("add", help="record a local summary without posting to Mattermost")
    add.add_argument("--source", default=os.environ.get("AGENT_STATUS_SOURCE", ""))
    add.add_argument("--channel", default="", help="intended Mattermost channel, if any")
    add.add_argument("message", nargs="*", help="summary; reads stdin when omitted")
    args = parser.parse_args()
    try:
        ctx = context(args.cwd)
        db = database()
        if args.command == "add":
            message = " ".join(args.message) if args.message else sys.stdin.read().rstrip("\n")
            if not message.strip():
                parser.error("empty message")
            record(db, ctx, args.source or Path(ctx["cwd"]).name, args.channel, message)
        else:
            rows = entries(db, ctx["project"], args.search, args.limit)
            if args.json:
                print(json.dumps(rows, ensure_ascii=False, indent=2))
            elif not rows:
                print(f"No work history for {ctx['project']}" + (f" matching {args.search!r}" if args.search else ""))
            else:
                print(f"Work history: {ctx['project']} (newest first)")
                for row in rows:
                    location = row["branch"] or row["commit"][:12]
                    print(f"\n{row['timestamp']}  {row['source']}" + (f"  [{location}]" if location else ""))
                    print(row["message"])
        return 0
    except (OSError, ValueError, sqlite3.Error) as error:
        print(f"agent-history: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
