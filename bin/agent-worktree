#!/usr/bin/env bash
# agent-worktree — create/inspect/remove the per-feature git worktrees agents
# are supposed to work in, instead of hand-rolling `git worktree add` and
# forgetting to actually switch to the branch.
#
# Feature work lives in <repo>/.worktrees/<name> on branch <name>. This script
# owns the whole ritual: pick the main checkout even when called from inside a
# worktree, keep .worktrees/ out of git, reuse an existing branch instead of
# failing, and CONFIRM that HEAD really is on the feature branch before it
# reports success (creating a branch you never checked out is the failure mode
# this exists to kill).
#
# Usage:
#   agent-worktree new <name> [--base <ref>] [--repo <path>]
#   agent-worktree path <name> [--repo <path>]     # print dir, create nothing
#   agent-worktree list [--repo <path>]
#   agent-worktree rm <name> [--repo <path>] [--force] [--delete-branch]
#   agent-worktree where [--repo <path>]           # what am I on right now?
#
# `new` prints the worktree path on stdout (and a human summary on stderr), so
# an agent can do:  cd "$(agent-worktree new my-feature)"
# and a harness can use that path as the cwd for subsequent tool calls.
#
# Notes:
#   - .worktrees/ is ignored via .git/info/exclude when it is not already
#     ignored, so no tracked .gitignore is modified in someone else's repo.
#   - Names may contain slashes (feat/foo -> .worktrees/feat/foo, branch feat/foo).

set -euo pipefail

prog=agent-worktree
die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
usage() { grep '^#' "$0" | sed 's/^# \{0,1\}//; 1d'; }

repo_arg=""
base=""
force=0
delete_branch=0
positional=()

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)          repo_arg="$2"; shift 2 ;;
        --base)          base="$2"; shift 2 ;;
        --force|-f)      force=1; shift ;;
        --delete-branch) delete_branch=1; shift ;;
        -h|--help)       usage; exit 0 ;;
        --)              shift; positional+=("$@"); break ;;
        -*)              die "unknown option '$1'" ;;
        *)               positional+=("$1"); shift ;;
    esac
done

# Main checkout root, even when invoked from inside a linked worktree.
main_root() {
    local start="${repo_arg:-$PWD}"
    git -C "$start" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "not inside a git repository (${start})"
    git -C "$start" worktree list --porcelain \
        | awk '/^worktree /{print substr($0,10); exit}'
}

root="$(main_root)"
wt_dir="$root/.worktrees"

ensure_ignored() {
    git -C "$root" check-ignore -q .worktrees 2>/dev/null && return 0
    local exclude
    exclude="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
    mkdir -p "$(dirname "$exclude")"
    printf '.worktrees/\n' >> "$exclude"
    printf '%s: ignored .worktrees/ via %s\n' "$prog" "$exclude" >&2
}

branch_exists() { git -C "$root" show-ref --verify --quiet "refs/heads/$1"; }

need_name() {
    [[ ${#positional[@]} -ge 1 ]] || die "$1 needs a <name> (see --help)"
    case "${positional[0]}" in
        -*|*..*|*' '*) die "invalid worktree name '${positional[0]}'" ;;
    esac
    printf '%s' "${positional[0]}"
}

case "$cmd" in
  new)
    name="$(need_name new)"
    dest="$wt_dir/$name"

    if [[ -d "$dest" ]]; then
        cur="$(git -C "$dest" rev-parse --abbrev-ref HEAD)"
        [[ "$cur" == "$name" ]] \
            || die "$dest already exists but is on '$cur', not '$name'"
        printf '%s: reusing existing worktree (branch %s)\n' "$prog" "$cur" >&2
        echo "$dest"
        exit 0
    fi

    ensure_ignored
    mkdir -p "$(dirname "$dest")"

    if branch_exists "$name"; then
        [[ -z "$base" ]] || die "branch '$name' already exists; drop --base or pick a new name"
        git -C "$root" worktree add "$dest" "$name" >&2
    else
        git -C "$root" worktree add -b "$name" "$dest" ${base:+"$base"} >&2
    fi

    # The whole point: prove HEAD is actually on the feature branch.
    cur="$(git -C "$dest" rev-parse --abbrev-ref HEAD)"
    [[ "$cur" == "$name" ]] || die "worktree created but HEAD is '$cur', expected '$name'"

    {
        printf '%s: worktree %s\n' "$prog" "$dest"
        printf '%s: branch   ⑂ %s (from %s)\n' "$prog" "$cur" \
            "$(git -C "$dest" rev-parse --short HEAD)"
        printf '%s: next     work with cwd=%s\n' "$prog" "$dest"
    } >&2
    echo "$dest"
    ;;

  path)
    name="$(need_name path)"
    echo "$wt_dir/$name"
    ;;

  list)
    git -C "$root" worktree list --porcelain | awk -v root="$wt_dir/" '
        /^worktree /{path=substr($0,10)}
        /^branch /{br=substr($0,8); sub("refs/heads/","",br)}
        /^detached/{br="(detached)"}
        /^$/{ if (path != "") printf "%-12s %s\n", (index(path, root)==1 ? "feature" : "main"), \
                 (br == "" ? "?" : br) " -> " path; path=""; br="" }
        END{ if (path != "") printf "%-12s %s\n", (index(path, root)==1 ? "feature" : "main"), \
                 (br == "" ? "?" : br) " -> " path }'
    ;;

  rm|remove)
    name="$(need_name rm)"
    dest="$wt_dir/$name"
    [[ -d "$dest" ]] || die "no worktree at $dest"
    if (( force )); then
        git -C "$root" worktree remove --force "$dest"
    else
        git -C "$root" worktree remove "$dest" \
            || die "worktree $dest is dirty; commit/stash there, or re-run with --force"
    fi
    printf '%s: removed %s\n' "$prog" "$dest" >&2
    if (( delete_branch )); then
        git -C "$root" branch -d "$name" \
            || die "branch '$name' not fully merged; delete it yourself with 'git branch -D $name'"
    fi
    ;;

  where)
    here="${repo_arg:-$PWD}"
    top="$(git -C "$here" rev-parse --show-toplevel)"
    br="$(git -C "$here" rev-parse --abbrev-ref HEAD)"
    if [[ "$top" == "$root" ]]; then
        printf 'main checkout %s on ⑂ %s\n' "$top" "$br"
        printf 'feature work belongs in a worktree: agent-worktree new <name>\n'
    else
        printf 'worktree %s on ⑂ %s\n' "$top" "$br"
    fi
    ;;

  help|--help|-h)
    usage
    ;;

  *)
    die "unknown subcommand '$cmd' (try: new, path, list, rm, where, help)"
    ;;
esac
