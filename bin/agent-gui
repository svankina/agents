#!/usr/bin/env python3
"""agent-gui — launch a GUI app onto the agent workspace (i3 workspace 9).

Agents must not drop windows into whatever workspace the user is looking at.
Doing that by hand means launching, guessing the window class, and firing an
`i3-msg [class="..."] move container to workspace number 9` that silently does
nothing when the class guess is wrong. This does it by identity instead:

  1. snapshot the con_ids already on the i3 tree,
  2. acquire an owned systemd process lease (output to its private log),
  3. poll for a NEW window belonging to the launched process tree,
  4. move exactly that container to the agent workspace, without switching to it.

Usage:
  agent-gui [--owner OWNER] [--workspace N] [--timeout SECS] [--match SUBSTR]
            [--log PATH] [--headless] [--focus] -- <command> [args...]

Examples:
  agent-gui -- freecad model.FCStd
  agent-gui --match blender -- flatpak run org.blender.Blender
  agent-gui --headless -- freecad model.FCStd   # agent display, screenshottable

Options:
  --workspace N   target workspace (default $AGENT_GUI_WORKSPACE or 9)
  --timeout SECS  how long to wait for the window (default 30)
  --match SUBSTR  also accept a new window whose class/title contains SUBSTR;
                  needed for launchers that hand off to another process tree
                  (flatpak, single-instance apps)
  --headless      launch on the off-screen agent display (agent-display) instead
                  of the user's screen. Use this whenever you intend to
                  screenshot the app: a window parked on hidden workspace 9 is
                  unmapped and cannot be captured, one on the agent display
                  always can (`agent-shot --class …`).
  --focus         switch to the workspace afterwards (default: do not disturb)
  --owner OWNER  session identity (default $AGENT_RESOURCE_OWNER; required)
  --owner-pid PID live owner process (default $AGENT_RESOURCE_PID or caller PID)
  --log PATH      create a new symlink to the lease-owned app log

Prints only the container id on stdout; lease id and log path go to stderr.
Exit codes: 0 moved, 2 usage/launch error, 3 no window or isolation failure.
Errors and timeouts release the lease; successful launches retain it until
`agent-resource release ID --owner OWNER --json` or owner death.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_WS = os.environ.get("AGENT_GUI_WORKSPACE", "9")
ENV = dict(os.environ)  # --headless rewrites DISPLAY here, for i3 and the app


def i3(*args: str) -> str:
    return subprocess.run(
        ["i3-msg", *args], check=True, capture_output=True, text=True, env=ENV
    ).stdout


def agent_display() -> str | None:
    """Bring up (or reuse) the off-screen agent display; returns e.g. ':99'."""
    cmd = shutil.which("agent-display") or str(Path(__file__).with_name("agent-display"))
    p = subprocess.run([cmd, "start"], capture_output=True, text=True)
    sys.stderr.write(p.stderr)
    return p.stdout.strip() or None


def tree() -> dict:
    return json.loads(i3("-t", "get_tree"))


def windows(node: dict, out: list | None = None) -> list[dict]:
    """Every node that owns a window, flattened."""
    out = [] if out is None else out
    if node.get("window") is not None or node.get("app_id"):
        out.append(node)
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, ()):
            windows(child, out)
    return out


def descendants(root_pid: int) -> set[int]:
    """root_pid plus every live descendant, read straight from /proc."""
    children: dict[int, list[int]] = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat", "rb") as fh:
                data = fh.read()
        except OSError:
            continue
        # comm can contain spaces/parens; ppid is the field after the last ')'.
        try:
            ppid = int(data[data.rindex(b")") + 2 :].split()[1])
        except (ValueError, IndexError):
            continue
        children.setdefault(ppid, []).append(int(entry))

    seen = {root_pid}
    stack = [root_pid]
    while stack:
        for kid in children.get(stack.pop(), ()):
            if kid not in seen:
                seen.add(kid)
                stack.append(kid)
    return seen


def window_pid(node: dict) -> int | None:
    if node.get("pid"):
        return node["pid"]
    if not node.get("window"):
        return None
    # Older i3 versions omit the PID even when the X11 window publishes it.
    result = subprocess.run(
        ["xprop", "-id", str(node["window"]), "_NET_WM_PID"],
        capture_output=True, text=True, env=ENV,
    )
    match = re.search(r"=\s*(\d+)", result.stdout)
    return int(match[1]) if match else None


def describe(node: dict) -> str:
    props = node.get("window_properties") or {}
    label = props.get("class") or node.get("app_id") or "?"
    title = node.get("name") or ""
    return f'{label} "{title}"'.strip()


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="agent-gui", add_help=False)
    ap.add_argument("--workspace", default=DEFAULT_WS)
    ap.add_argument("--timeout", type=float, default=30.0)
    ap.add_argument("--match")
    ap.add_argument("--log")
    ap.add_argument("--owner", default=os.environ.get("AGENT_RESOURCE_OWNER"))
    ap.add_argument("--owner-pid", type=int,
                    default=os.environ.get("AGENT_RESOURCE_PID", os.getppid()))
    ap.add_argument("--headless", action="store_true")
    ap.add_argument("--focus", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("command", nargs=argparse.REMAINDER)
    args = ap.parse_args(argv)

    if args.help:
        print(__doc__.strip())
        return 0

    cmd = args.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        print("agent-gui: no command given (use -- before the command)", file=sys.stderr)
        return 2
    if not args.owner:
        print("agent-gui: --owner or AGENT_RESOURCE_OWNER is required", file=sys.stderr)
        return 2

    if args.headless:
        display = agent_display()
        if display is None:
            print("agent-gui: could not start the agent display; "
                  "run `agent-display status`", file=sys.stderr)
            return 3
        ENV["DISPLAY"] = display
        ENV.pop("WAYLAND_DISPLAY", None)
        ENV.pop("I3SOCK", None)  # else i3-msg talks to the user's i3

    try:
        before = {n["id"] for n in windows(tree())}
    except (FileNotFoundError, subprocess.CalledProcessError, ValueError) as exc:
        print(f"agent-gui: i3 not reachable ({exc}); refusing an unisolated launch",
              file=sys.stderr)
        return 3

    broker = shutil.which("agent-resource") or str(Path(__file__).with_name("agent-resource"))
    lease = None
    keep = False
    try:
        launched = subprocess.run(
            [broker, "acquire", "--owner", args.owner, "--owner-pid", str(args.owner_pid),
             "--name", os.path.basename(cmd[0]), "--kind", "gui", "--json", "--", *cmd],
            capture_output=True, text=True, env=ENV,
        )
        payload = json.loads(launched.stdout)
        if launched.returncode:
            raise RuntimeError(payload.get("error", "resource acquisition failed"))
        lease = payload
        log_path = lease["log"]
        if args.log:
            os.symlink(log_path, args.log)
        print(f'agent-gui: launched pid {lease["pid"]}, lease {lease["id"]}, log {log_path}',
              file=sys.stderr)
        deadline = time.monotonic() + args.timeout
        target = None
        while time.monotonic() < deadline:
            time.sleep(0.4)
            fresh = [n for n in windows(tree()) if n["id"] not in before]
            pids = descendants(lease["pid"]) if lease["pid"] else set()
            target = next((n for n in fresh if window_pid(n) in pids), None)
            if target is None and args.match:
                needle = args.match.lower()
                matches = [n for n in fresh if needle in describe(n).lower()]
                if len(matches) == 1:
                    target = matches[0]
            if target:
                break
        if target is None:
            print(f"agent-gui: no window found within {args.timeout:g}s; releasing lease; "
                  f"see {log_path}", file=sys.stderr)
            return 3
        if args.headless:
            print(f"agent-gui: {describe(target)} is on the agent display "
                  f'{ENV["DISPLAY"]} — capture it with '
                  f'`agent-shot --con-id {target["id"]}`', file=sys.stderr)
        else:
            i3("-q", f'[con_id={target["id"]}]',
               f"move container to workspace number {args.workspace}")
            if args.focus:
                i3("-q", f"workspace number {args.workspace}")
            print(f"agent-gui: moved {describe(target)} to workspace {args.workspace}; "
                  "use --headless for screenshots", file=sys.stderr)
        print(target["id"])
        keep = True
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"agent-gui: {exc}", file=sys.stderr)
        return 2
    finally:
        if lease is not None and not keep:
            released = subprocess.run(
                [broker, "release", lease["id"], "--owner", args.owner, "--json"],
                capture_output=True, text=True, env=ENV,
            )
            if released.returncode:
                print(f'agent-gui: cleanup failed for lease {lease["id"]}: {released.stdout.strip()}',
                      file=sys.stderr)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
